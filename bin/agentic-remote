#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly SERVICE_NAME="agentic-remote.service"
readonly SYSTEMD_DIR="$HOME/.config/systemd/user"
readonly SERVICE_FILE="$SYSTEMD_DIR/$SERVICE_NAME"
readonly CONFIG_DIR="$HOME/.config/agentic-remote"
readonly ENV_FILE="$CONFIG_DIR/environment"
readonly COMMAND_LINK="$HOME/.local/bin/agentic-remote"
readonly VOICE_PROFILE_MANIFEST="$REPO_ROOT/config/oracle-voice-profiles.json"
VOICE_INSTALL_CLEANUP_PATH=""
VOICE_INSTALL_CLEANUP_LINK=""

usage() {
  cat <<'EOF'
Usage: agentic-remote <command> [options]

Commands:
  setup [--host ADDRESS] [--port PORT] [--role hub|node] [--name NAME] [--release-id ID]
      Install dependencies, build the app, install and start the user service.
  pair-info
      Print this node's URL, identity, and pairing token.
  start
      Start the service.
  stop
      Stop the service.
  restart
      Restart the service.
  status
      Show service status.
  doctor [--json] [--tunnel ID]
      Diagnose the installation without changing it, even with the service down.
  logs [--why [--since TIME] [--json]]
      Follow service logs, or explain the last failure without changing anything.
  update
      Pull the current branch, install dependencies, build, and restart.
  rollback
      Activate the previous immutable release and restart the service.
  voice-install [--accept-research-only] <profile>
      Explicitly download, verify, and atomically activate a local voice profile.
  uninstall
      Stop and remove the service. Application data is preserved.
  help
      Show this help.
EOF
}

die() {
  printf 'agentic-remote: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

config_value() {
  local key="$1"
  if [[ ! -f "$ENV_FILE" ]]; then
    return
  fi
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1
}

diagnostic_node() {
  {
    cat <<'NODE'
const fs = require('node:fs')
const path = require('node:path')
const { spawnSync } = require('node:child_process')
const record = (value) => value !== null && typeof value === 'object' && !Array.isArray(value)
const parseRecord = (line) => {
  try { const value = JSON.parse(line); return record(value) ? value : undefined } catch {}
}
const text = (value) => String(value).replace(/[\x00-\x1f\x7f-\x9f]/g, ' ').trim().slice(0, 500)
const executable = (name) => {
  for (const candidate of name.includes('/') ? [name] :
    (process.env.PATH || '').split(path.delimiter).map((directory) => path.join(directory, name))) {
    try {
      fs.accessSync(candidate, fs.constants.X_OK)
      if (fs.statSync(candidate).isFile()) return candidate
    } catch {}
  }
}
const run = (binary, args) => spawnSync(binary, args, {
  encoding: 'utf8', timeout: 10000, maxBuffer: 1024 * 1024,
  stdio: ['ignore', 'pipe', 'pipe'],
})
const success = (result) => !result.error && result.status === 0
function startupSignals(items) {
  const pending = new Map()
  let lastFailure
  for (const [index, item] of items.entries()) {
    if (!record(item) || typeof item.startupPhase !== 'string' ||
      !/^[A-Za-z0-9._-]{1,128}$/.test(item.startupPhase)) continue
    if (item.startupPhase === 'app.build' && item.event === 'begin') pending.clear()
    if (item.event === 'begin') pending.set(item.startupPhase, { phase: item.startupPhase, index })
    if (item.event === 'complete' || item.event === 'fail') pending.delete(item.startupPhase)
    if (item.event === 'fail') lastFailure = { phase: item.startupPhase, index }
  }
  return { lastFailure, unfinished: [...pending.values()].at(-1) }
}
NODE
    cat
  } | node - "$@"
}

logs() {
  if (($# == 0)); then
    exec journalctl --user --unit "$SERVICE_NAME" --follow
  fi
  local why="false" json="false" since="-6h"
  while (($# > 0)); do
    case "$1" in
      --why)
        why="true"
        shift
        ;;
      --json)
        json="true"
        shift
        ;;
      --since)
        if (($# < 2)) || [[ -z "$2" || ( "$2" == -* && ! "$2" =~ ^-[0-9] ) ]]; then
          printf '%s\n' 'agentic-remote: --since requires a journalctl time' >&2
          return 2
        fi
        since="$2"
        shift 2
        ;;
      --help | -h)
        cat <<'EOF'
Usage: agentic-remote logs [--why [--since TIME] [--json]]

No options: follow the service journal, unchanged.
  --why         Explain the last startup, structured error, or unit failure.
  --since TIME  Journal time window (default: -6h); requires --why.
  --json        Emit {failure, correlation, before:[...], after:[...]}; requires --why.
  --help, -h    Show this help.

Reads the whole window (up to 64 MB of journal output; narrow --since if it
is larger), even with the service down. Shows up to 20
preceding lines with the same session/request/phase/computer, the last 20
remaining lines in the preceding 2-minute window, and up to 5 following lines. Human times are
local; JSON times are ISO timestamps. Obvious secrets are redacted.
No environment files are read, no network probes run, and nothing is changed.
Exit 0 with or without a failure, 2 for usage errors, 1 if the journal cannot
be read (or Node.js is unavailable).
EOF
        return
        ;;
      *)
        printf '%s\n' 'agentic-remote: unknown logs option; see logs --help' >&2
        return 2
        ;;
    esac
  done
  if [[ "$why" != "true" ]]; then
    printf '%s\n' 'agentic-remote: logs options require --why; see logs --help' >&2
    return 2
  fi
  require_command node
  diagnostic_node "$SERVICE_NAME" "$since" "$json" <<'NODE'
const [serviceName, since, json] = process.argv.slice(2)
function redact(value) {
  if (Array.isArray(value)) return value.map(redact)
  if (record(value)) return Object.fromEntries(Object.entries(value).map(([key, item]) => [
    key, /token|authorization|password|passwd|secret|api[_-]?key|cookie|credential/i.test(key) ? '[REDACTED]' : redact(item),
  ]))
  if (typeof value !== 'string') return value
  return value
    .replace(/-----BEGIN ((?:[A-Z0-9]+ )*PRIVATE KEY)-----[\s\S]*?(?:-----END \1-----|$)/g, '[REDACTED]')
    .replace(/(\b[a-z][a-z0-9+.-]*:\/\/)[^\s/?#]+@/gi, '$1[REDACTED]@')
    .replace(/([?&])([^=&\s"'<>#]+)=([^&#\s"'<>]*)/g, (match, separator, key) => {
      let name = key
      try { name = decodeURIComponent(key.replace(/\+/g, ' ')) } catch {}
      return /token|authorization|password|passwd|secret|api[_-]?key|credential|cookie|signature|^(?:auth|code|sig)$/i.test(name)
        ? `${separator}${key}=[REDACTED]` : match
    })
    .replace(/(\b(?:proxy-)?authorization["']?\s*[:=]\s*["']?)(?:(?:Bearer|Basic)\s+)?[^\s,;"'}]+/gi, '$1[REDACTED]')
    .replace(/\b(Bearer|Basic)\s+[A-Za-z0-9._~+/=-]+/gi, '$1 [REDACTED]')
    .replace(/(\b[\w.-]*(?:token|password|passwd|secret|api[_-]?key|credential)[\w.-]*["']?\s*[:=]\s*)(?:"[^"]*"|'[^']*'|[^\s,;&}]+)/gi, '$1[REDACTED]')
    .replace(/(--[\w-]*(?:token|password|secret|api-key)[\w-]*\s+)(?:"[^"]*"|'[^']*'|[^\s,;]+)/gi, '$1[REDACTED]')
    .replace(/\b(?:gh[pousr]_[A-Za-z0-9]+|github_pat_[A-Za-z0-9_]+|sk-[A-Za-z0-9_-]{12,}|eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+)\b/g, '[REDACTED]')
}
const clean = (value) => text(redact(value))
const lineText = (value) => String(value).replace(/[\x00-\x1f\x7f-\x9f]/g, ' ').trim().slice(0, 2000)
const rendered = (entry) => entry.privateKeyFragment ? '[REDACTED]' :
  lineText(entry.item ? JSON.stringify(redact(entry.item)) : redact(entry.message))
function timestamp(journal, item) {
  const micros = journal?.__REALTIME_TIMESTAMP || journal?._SOURCE_REALTIME_TIMESTAMP
  const value = micros ? Number(micros) / 1000 : item?.time ?? item?.timestamp
  if (value === undefined || value === null) return null
  const date = new Date(value)
  return Number.isNaN(date.getTime()) ? null : date.toISOString()
}
function correlations(item) {
  const output = {}
  for (const [key, aliases] of Object.entries({
    sessionId: ['sessionId', 'session_id'],
    computerId: ['computerId', 'computer_id'],
    requestId: ['requestId', 'reqId', 'request_id'],
    phase: ['startupPhase', 'phase'],
  })) {
    const value = aliases.map((alias) => item?.[alias]).find((value) => typeof value === 'string' && value.trim())
    if (value) output[key] = value
  }
  return output
}
const JOURNAL_MAX_BYTES = 64 * 1024 * 1024
class JournalTooLarge extends Error {}
function explain() {
  if (!executable('journalctl')) throw new Error()
  // Structured service lines are large; request only MESSAGE (address fields such as
  // __REALTIME_TIMESTAMP are always included) and allow a bounded larger buffer.
  const journal = spawnSync('journalctl', ['--user', '--unit', serviceName, '-o', 'json', '--output-fields=MESSAGE',
    '--since', since, '--no-pager'], {
    encoding: 'utf8', timeout: 20000, maxBuffer: JOURNAL_MAX_BYTES, stdio: ['ignore', 'pipe', 'pipe'],
  })
  if (journal.error?.code === 'ENOBUFS') throw new JournalTooLarge()
  if (!success(journal) || /permission denied|insufficient permissions|not permitted/i.test(journal.stderr)) throw new Error()
  let privateKey
  const entries = journal.stdout.split('\n').filter((line) => line.trim()).map((line) => {
    const envelope = parseRecord(line)
    const message = typeof envelope?.MESSAGE === 'string' ? envelope.MESSAGE : line
    const item = parseRecord(message)
    // Track split PEM blocks across the whole journal before limiting displayed context.
    const continuedKey = !!privateKey
    for (const marker of message.matchAll(/-----(BEGIN|END) ((?:[A-Z0-9]+ )*PRIVATE KEY)-----/g)) {
      if (marker[1] === 'BEGIN') privateKey = marker[2]
      else if (privateKey === marker[2]) privateKey = undefined
    }
    return { item, message, time: timestamp(envelope, item), correlation: correlations(item),
      privateKeyFragment: continuedKey || !!privateKey }
  })
  const { lastFailure, unfinished } = startupSignals(entries.map((entry) => entry.item))
  let signal = lastFailure && { ...lastFailure, kind: 'startup' }
  if (!signal && unfinished) {
    const state = run('systemctl', ['--user', 'is-active', serviceName])
    // Unknown state is not evidence that a running phase is unfinished.
    if (!state.error && state.status !== 0 && /^(inactive|failed|deactivating)$/.test(state.stdout.trim())) {
      signal = { ...unfinished, kind: 'unfinished-startup' }
    }
  }
  if (!signal) {
    const index = entries.findLastIndex(({ item }) => {
      if (!item) return false
      const level = typeof item.level === 'string' ? item.level.trim().toLowerCase() : item.level
      if ((typeof level === 'number' || (typeof level === 'string' && level !== '')) && Number.isFinite(Number(level))) {
        return Number(level) >= 50
      }
      if (typeof level === 'string' && /^(trace|debug|info|warn|warning|error|fatal)$/.test(level)) {
        return /^(error|fatal)$/.test(level)
      }
      return item.err != null || item.type === 'error'
    })
    if (index >= 0) signal = { index, kind: 'error' }
  }
  if (!signal) {
    const index = entries.findLastIndex(({ item, message }) => !item &&
      /\bFailed with result\b|\bStart request repeated too quickly\b|\bFailed to start\b|\bcode=(?:killed|dumped)\b|\bstatus=[1-9]\d*(?:\/|\b)/i.test(message))
    if (index >= 0) signal = { index, kind: 'unit' }
  }
  if (!signal) return { failure: null, correlation: {}, omittedWindowLines: 0, before: [], after: [] }
  const entry = entries[signal.index]
  const summary = entry.item?.msg ?? entry.item?.message ?? entry.item?.err?.message ?? entry.message
  const failure = {
    kind: signal.kind, time: entry.time,
    message: entry.privateKeyFragment ? '[REDACTED]' : clean(signal.phase
      ? `${signal.kind === 'startup' ? 'Failed' : 'Unfinished'} startup phase: ${signal.phase}${signal.kind === 'unfinished-startup' ? ' (begin without complete/fail; service not active)' : ''}`
      : typeof summary === 'string' ? summary : JSON.stringify(redact(summary))),
    ...(signal.phase ? { phase: clean(signal.phase) } : {}),
    line: rendered(entry),
  }
  const preceding = entries.slice(0, signal.index)
  const key = ['sessionId', 'requestId', 'phase', 'computerId'].find((key) => entry.correlation[key])
  const label = { sessionId: 'same session', requestId: 'same request', phase: 'same phase', computerId: 'same computer' }[key]
  const same = key ? preceding.filter((item) => item.correlation[key] === entry.correlation[key]).slice(-20) : []
  const window = preceding.filter((item) => !same.includes(item) && entry.time && item.time &&
    Date.parse(item.time) >= Date.parse(entry.time) - 120000 && Date.parse(item.time) <= Date.parse(entry.time))
  // A busy hub logs hundreds of requests per minute; keep the lines closest to the failure.
  const nearby = window.slice(-20)
  const output = (item, block) => ({
    block, time: item.time, message: rendered(item),
  })
  return {
    failure, correlation: entry.privateKeyFragment ? {} : redact(entry.correlation), omittedWindowLines: window.length - nearby.length,
    before: [...same.map((item) => output(item, label)), ...nearby.map((item) => output(item, 'time window'))],
    after: entries.slice(signal.index + 1, signal.index + 6).map((item) => output(item, 'after')),
  }
}
try {
  const result = explain()
  if (json === 'true') console.log(JSON.stringify(result))
  else if (!result.failure) console.log(`No failure found in ${clean(since)}`)
  else {
    const localTime = (time) => time ? new Date(time).toLocaleString(undefined, { timeZoneName: 'short' }) : 'time unavailable'
    console.log(`Failure · ${localTime(result.failure.time)}\n${result.failure.message}`)
    console.log(`  ${result.failure.line}`)
    const keys = Object.entries(result.correlation)
    if (keys.length) console.log(`Correlation: ${keys.map(([key, value]) => `${key}=${clean(value)}`).join(' · ')}`)
    let block
    for (const item of [...result.before, ...result.after]) {
      if (item.block !== block) {
        block = item.block
        console.log(`\n[${block}]`)
        if (block === 'time window' && result.omittedWindowLines > 0) {
          console.log(`  … ${result.omittedWindowLines} earlier lines in the 2-minute window omitted`)
        }
      }
      console.log(`  ${localTime(item.time)}  ${item.message}`)
    }
  }
} catch (error) {
  console.error(error instanceof JournalTooLarge
    ? `agentic-remote: journal output exceeded ${JOURNAL_MAX_BYTES / 1024 / 1024} MB; narrow it with --since`
    : 'agentic-remote: user journal could not be read; check journalctl availability, permissions, and --since')
  process.exitCode = 1
}
NODE
}

doctor() {
  local json="false" tunnel=""
  while (($# > 0)); do
    case "$1" in
      --json)
        json="true"
        shift
        ;;
      --tunnel)
        (($# >= 2)) && [[ -n "$2" && "$2" != -* ]] ||
          die "--tunnel requires an ID"
        tunnel="$2"
        shift 2
        ;;
      --help | -h)
        cat <<'EOF'
Usage: agentic-remote doctor [--json] [--tunnel ID]

Read-only installation, provider, loopback health, and startup diagnostics.
  --json        Emit an array of {check, status, detail} records.
  --tunnel ID   Inspect login and tunnel/port ACLs (no ACL changes).
                Defaults to AGENTIC_REMOTE_DEVTUNNEL_ID in the environment
                or the installed service environment file.
  --help, -h    Show this help.

Exit 0 if no check fails; exit 1 if any check fails. Optional checks may skip.
No installs, restarts, or files are written. Only loopback health probes and
read-only devtunnel queries use the network. The package manager is not run.
EOF
        return
        ;;
      *)
        die "unknown doctor option: $1"
        ;;
    esac
  done
  if ! command -v node >/dev/null 2>&1; then
    if [[ "$json" == "true" ]]; then
      printf '%s\n' '[{"check":"node","status":"fail","detail":"Node.js is not on PATH; remaining checks require Node.js"}]'
    else
      printf '%s\n' '✗ node [fail]: Node.js is not on PATH; remaining checks require Node.js'
    fi
    return 1
  fi

  diagnostic_node "$REPO_ROOT" "$ENV_FILE" "$SERVICE_FILE" "$SERVICE_NAME" "$json" "$tunnel" <<'NODE'
const http = require('node:http')
const { isIP } = require('node:net')
const [repository, environmentFile, serviceFile, serviceName, json, tunnelOption] = process.argv.slice(2)
const results = []
const add = (check, status, detail) => results.push({ check, status, detail: text(detail) })
const readJson = (file) => JSON.parse(fs.readFileSync(file, 'utf8'))
const metadata = (file) => { try { return fs.statSync(file) } catch { return undefined } }
const configured = new Map()
let environmentError
try {
  // Never source this file: values (including shell substitutions) are data.
  for (const line of fs.readFileSync(environmentFile, 'utf8').split('\n')) {
    const match = /^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/.exec(line.trim())
    if (!match) continue
    let value = match[2].trim()
    if ((value.startsWith('"') && value.endsWith('"')) ||
      (value.startsWith("'") && value.endsWith("'"))) value = value.slice(1, -1)
    configured.set(match[1], value)
  }
} catch { environmentError = true }
const value = (key, fallback = '') => (process.env[key] || configured.get(key) || fallback).trim()
const tunnel = tunnelOption || value('AGENTIC_REMOTE_DEVTUNNEL_ID')
const host = value('HOST', '127.0.0.1')
const port = value('PORT', '4317')
const validPort = /^\d+$/.test(port) && Number(port) >= 1 && Number(port) <= 65535
const dataDirectory = value('AGENTIC_REMOTE_DATA_DIR', path.join(process.env.HOME, '.agentic-remote'))

function runtimeChecks() {
  let manifest
  try { manifest = readJson(path.join(repository, 'package.json')) } catch {
    add('node', 'fail', 'Cannot read package.json engines')
    add('pnpm', 'fail', 'Cannot read package.json packageManager')
    return
  }
  // The repository declares a minimum Node version; fail closed if that contract changes.
  const minimum = /^>=(\d+)\.(\d+)(?:\.(\d+))?$/.exec(manifest.engines?.node || '')
  const current = process.versions.node.split('.').map(Number)
  const required = minimum?.slice(1).map((part) => Number(part || 0))
  const difference = required && current.map((part, index) => part - required[index]).find((part) => part !== 0)
  const compatible = required && (difference === undefined || difference > 0)
  add('node', compatible ? 'ok' : 'fail',
    `Node.js ${process.versions.node}; requires ${manifest.engines?.node || 'an unknown engine range'}`)

  const pin = /^pnpm@(\d+\.\d+\.\d+)(?:\+sha\d+\..+)?$/.exec(manifest.packageManager || '')?.[1]
  const pnpm = executable('pnpm')
  let resolved = false
  if (pin && pnpm) {
    // Inspect installed metadata, not `pnpm --version`: Corepack and pnpm shims
    // can otherwise download a missing version or update caches during diagnosis.
    let directory = path.dirname(fs.realpathSync(pnpm))
    for (;;) {
      try {
        const installed = readJson(path.join(directory, 'package.json'))
        if (installed.name === 'pnpm' && installed.version === pin) resolved = true
      } catch {}
      const parent = path.dirname(directory)
      if (parent === directory) break
      directory = parent
    }
    const corepackHome = process.env.COREPACK_HOME ||
      path.join(process.env.XDG_CACHE_HOME || path.join(process.env.HOME, '.cache'), 'node/corepack')
    try {
      const installed = readJson(path.join(corepackHome, 'v1/pnpm', pin, 'package.json'))
      resolved ||= installed.name === 'pnpm' && installed.version === pin &&
        !!executable(path.join(corepackHome, 'v1/pnpm', pin, 'bin/pnpm.cjs'))
    } catch {}
  }
  add('pnpm', resolved ? 'ok' : 'fail', resolved
    ? `pnpm ${pin} is available locally (not executed)`
    : `Pinned ${manifest.packageManager || 'pnpm version'} is not locally resolvable; no install attempted`)
}

function serviceChecks() {
  add('service.unit', metadata(serviceFile)?.isFile() ? 'ok' : 'fail',
    metadata(serviceFile)?.isFile() ? `${serviceName} is installed` : `${serviceName} user unit is missing`)
  let active = false
  for (const state of ['enabled', 'active']) {
    if (!executable('systemctl')) {
      add(`service.${state}`, 'skip', 'systemctl is not on PATH')
      continue
    }
    const result = run('systemctl', ['--user', `is-${state}`, serviceName])
    const matches = success(result) && result.stdout.trim() === state
    if (state === 'active') active = matches
    add(`service.${state}`, matches ? 'ok' : 'fail',
      matches ? `User unit is ${state}` : `User unit is not ${state} (or user manager is unavailable)`)
  }
  const environment = metadata(environmentFile)
  const privateFile = environment?.isFile() && environment.uid === process.getuid() &&
    (environment.mode & 0o077) === 0 && !environmentError
  add('service.environment', privateFile ? 'ok' : 'fail', privateFile
    ? 'Service environment is readable, owned by this user, and owner-only'
    : 'Service environment is missing, unreadable, not owned by this user, or not owner-only')
  const release = value('AGENTIC_REMOTE_RELEASE_DIR', path.join(path.dirname(environmentFile), 'releases/current'))
  add('service.release', metadata(release)?.isDirectory() ? 'ok' : 'fail',
    metadata(release)?.isDirectory() ? 'Current release directory is present' : 'Current release directory is missing')
  return active
}

async function healthCheck() {
  if (!validPort) return add('health', 'fail', 'Configured PORT must be between 1 and 65535')
  let address = host
  if (host === '0.0.0.0' || host === 'localhost') address = '127.0.0.1'
  if (host === '::' || host === '[::]' || host === '[::1]') address = '::1'
  if (!(address === '::1' || (isIP(address) === 4 && address.startsWith('127.')))) {
    return add('health', 'skip', 'Configured HOST is not loopback; no non-loopback probe attempted')
  }
  await new Promise((resolve) => {
    let finished = false
    const finish = (status, detail) => {
      if (finished) return
      finished = true
      clearTimeout(timer)
      add('health', status, detail)
      resolve()
    }
    const url = `http://${address.includes(':') ? `[${address}]` : address}:${port}/health`
    const request = http.get(url, (response) => {
      let body = ''
      response.setEncoding('utf8')
      response.on('data', (chunk) => {
        body += chunk
        if (body.length > 65536) request.destroy()
      })
      response.on('error', () => finish('fail', 'Loopback health response was interrupted'))
      response.on('end', () => {
        try {
          const health = JSON.parse(body)
          if (response.statusCode !== 200 || !record(health) || health.ok !== true) throw new Error()
          const facts = { role: health.role, name: health.node?.name ?? health.name,
            version: health.node?.version ?? health.version }
          const detail = Object.entries(facts).filter(([, item]) => typeof item === 'string')
            .map(([key, item]) => `${key}=${text(item)}`).join(', ')
          finish('ok', `${url} ok${detail ? `; ${detail}` : ''}`)
        } catch { finish('fail', 'Loopback /health did not return HTTP 200 with ok=true') }
      })
    })
    const timer = setTimeout(() => request.destroy(), 3000)
    request.on('error', () => finish('fail', `Loopback /health is unavailable at ${url} (service may be down)`))
  })
}

function providerChecks() {
  const copilot = executable(value('COPILOT_BIN', 'copilot'))
  const version = copilot && run(copilot, ['--version'])
  add('providers.copilot', version && success(version) && version.stdout.trim() ? 'ok' : 'fail',
    version && success(version) && version.stdout.trim()
      ? text(version.stdout.split('\n')[0]) : 'Copilot CLI is missing or --version failed')
  add('providers.tmux', executable('tmux') ? 'ok' : 'fail',
    executable('tmux') ? 'tmux is on PATH' : 'tmux is not on PATH')
  const defaultClaude = path.join(process.env.HOME, '.local/bin/claude')
  const claude = value('CLAUDE_BIN') || (metadata(defaultClaude) ? defaultClaude : '')
  if (!claude) {
    add('providers.claude', 'skip', 'Claude support is not configured (no CLAUDE_BIN or default installation)')
  } else {
    try {
      const binary = executable(claude)
      const result = binary && run(binary, ['auth', 'status'])
      if (!result || !success(result) || JSON.parse(result.stdout)?.loggedIn !== true) throw new Error()
      add('providers.claude', 'ok', 'Claude is authenticated')
    } catch { add('providers.claude', 'fail', 'Configured Claude CLI is missing, not authenticated, or returned unknown auth JSON') }
  }
}

function assetChecks() {
  const whisper = value('AGENTIC_REMOTE_WHISPER_BIN')
  const model = value('AGENTIC_REMOTE_WHISPER_MODEL')
  if (!whisper && !model) {
    add('transcription.whisper', 'skip', 'Local Whisper transcription is not configured')
    add('transcription.model', 'skip', 'Local Whisper transcription is not configured')
  } else {
    const binary = whisper || path.join(process.env.HOME, '.local/bin/whisper-cli')
    const modelFile = model || path.join(dataDirectory, 'models/ggml-small.bin')
    add('transcription.whisper', executable(binary) ? 'ok' : 'fail',
      executable(binary) ? 'Configured whisper-cli is executable' : 'Configured whisper-cli is missing or not executable')
    add('transcription.model', metadata(modelFile)?.isFile() ? 'ok' : 'fail',
      metadata(modelFile)?.isFile() ? 'Whisper model is present' : 'Whisper model is missing')
  }
  if (value('AGENTIC_REMOTE_ORACLE_VOICE') !== 'on') {
    return add('voice.assets', 'skip', 'Oracle voice is off')
  }
  if (value('AGENTIC_REMOTE_ROLE', 'hub') === 'hub' && value('AGENTIC_REMOTE_VOICE_COMPUTER')) {
    return add('voice.assets', 'skip', 'Oracle voice uses a remote computer; local assets are not required')
  }
  const assets = [
    ['AGENTIC_REMOTE_VOICE_STT_MODEL_DIR', 'directory'],
    ['AGENTIC_REMOTE_VOICE_TTS_MODEL', 'file'],
    ['AGENTIC_REMOTE_VOICE_TTS_CONFIG', 'file'],
    ...(value('AGENTIC_REMOTE_VOICE_TTS_ENGINE') === 'sherpa-vits'
      ? [['AGENTIC_REMOTE_VOICE_TTS_TOKENS', 'file'], ['AGENTIC_REMOTE_VOICE_TTS_DATA_DIR', 'directory']]
      : [['AGENTIC_REMOTE_VOICE_TTS_BIN', 'executable']]),
  ]
  const missing = assets.filter(([key, kind]) => {
    const configuredPath = value(key)
    const file = path.resolve(dataDirectory, configuredPath)
    const stat = metadata(file)
    return !configuredPath || (kind === 'directory' ? !stat?.isDirectory() :
      !stat?.isFile() || (kind === 'executable' && !executable(file)))
  }).map(([key]) => key)
  add('voice.assets', missing.length ? 'fail' : 'ok',
    missing.length ? `Missing or unusable voice assets: ${missing.join(', ')}` : 'Configured local STT and TTS assets are present')
}

function originCheck() {
  try {
    const entries = value('AGENTIC_REMOTE_ALLOWED_ORIGINS').split(',').map((item) => item.trim()).filter(Boolean)
    const origins = entries.map((entry) => {
      const parsed = new URL(entry)
      if (!['http:', 'https:'].includes(parsed.protocol) || !parsed.host || parsed.origin === 'null') throw new Error()
      return parsed
    })
    const loopback = !entries.length || origins.some((origin) =>
      ['localhost', '127.0.0.1', '[::1]'].includes(origin.hostname))
    if (!loopback) return add('origins', 'fail', 'Allowed origins do not include loopback')
    const [tunnelId, ...tunnelRegion] = tunnel.toLowerCase().split('.')
    const tunnelOrigin = origins.some((origin) => {
      const labels = origin.hostname.split('.')
      return origin.protocol === 'https:' && !origin.port &&
        labels[0] === `${tunnelId}-${port}` && labels.slice(-2).join('.') === 'devtunnels.ms' &&
        (tunnelRegion.length ? labels.slice(1, -2).join('.') === tunnelRegion.join('.') :
          labels.length === 3 || labels.length === 4)
    })
    add('origins', tunnel && !tunnelOrigin ? 'warn' : 'ok', tunnel && !tunnelOrigin
      ? 'Allowed origins include loopback but not the selected tunnel HTTPS origin and port'
      : `Allowed origins parse and include loopback${tunnel ? ' and the selected tunnel origin' :
        entries.length ? '' : ' (server defaults)'}`)
  } catch { add('origins', 'fail', 'Invalid AGENTIC_REMOTE_ALLOWED_ORIGINS entry; expected http(s)://host[:port]') }
}

function tunnelChecks() {
  if (!tunnel || !executable('devtunnel')) {
    for (const check of ['tunnel.auth', 'tunnel.acl', 'tunnel.port-acl']) {
      add(check, tunnel ? 'fail' : 'skip', !tunnel
        ? 'No tunnel ID configured (use --tunnel ID)'
        : 'devtunnel is not on PATH; cannot verify the selected tunnel (fail closed; ACLs unchanged)')
    }
    return
  }
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(tunnel)) {
    for (const check of ['tunnel.auth', 'tunnel.acl', 'tunnel.port-acl']) add(check, 'fail', 'Invalid tunnel ID')
    return
  }
  let loggedOut = false
  try {
    const result = run('devtunnel', ['user', 'show', '--json'])
    if (!success(result)) throw new Error()
    const user = JSON.parse(result.stdout)
    if (record(user) && typeof user.status === 'string' && user.status.toLowerCase() === 'not logged in') {
      loggedOut = true
      throw new Error()
    }
    if (!record(user) || typeof user.status !== 'string' || user.status.toLowerCase() !== 'logged in' ||
      typeof user.provider !== 'string' || !/^[A-Za-z][A-Za-z0-9 ._-]{0,63}$/.test(user.provider)) throw new Error()
    add('tunnel.auth', 'ok', `Logged in; provider=${user.provider}`)
  } catch {
    add('tunnel.auth', 'fail', loggedOut
      ? 'devtunnel on this computer is not logged in; run devtunnel user login on the computer that owns the tunnel'
      : 'Dev Tunnel login is unavailable or returned unknown JSON')
  }
  for (const [check, portArgs] of [['tunnel.acl', []], ['tunnel.port-acl', ['--port-number', port]]]) {
    if (portArgs.length && !validPort) {
      add(check, 'fail', 'Cannot inspect port ACL: invalid PORT')
      continue
    }
    if (loggedOut) {
      add(check, 'fail', 'Cannot verify deny-only ACL without a devtunnel login (fail closed; ACLs unchanged)')
      continue
    }
    try {
      const result = run('devtunnel', ['access', 'list', tunnel, ...portArgs, '--json'])
      if (!success(result)) throw new Error()
      const acl = JSON.parse(result.stdout)
      if (!record(acl) || !Array.isArray(acl.accessControlEntries) ||
        acl.accessControlEntries.some((entry) => !record(entry) || typeof entry.isDeny !== 'boolean')) throw new Error()
      const allow = acl.accessControlEntries.some((entry) => entry.isDeny !== true)
      add(check, allow ? 'fail' : 'ok', allow
        ? 'tunnel is reachable by more than its owner; an allow entry exists (ACLs unchanged)'
        : `${portArgs.length ? `Port ${port}` : 'Tunnel'} ACL is deny-only (${acl.accessControlEntries.length} entries)`)
    } catch { add(check, 'fail', 'Cannot verify deny-only ACL: query failed or malformed/unknown JSON (fail closed; ACLs unchanged)') }
  }
}

function startupCheck(active) {
  if (!executable('journalctl')) return add('startup', 'skip', 'journalctl is not on PATH')
  const journal = run('journalctl', ['--user', '--unit', serviceName, '-o', 'cat', '--since', '-2h', '--no-pager', '-n', '2000'])
  if (!success(journal)) return add('startup', 'warn', 'Recent user journal could not be read')
  const signals = startupSignals(journal.stdout.split('\n').map(parseRecord))
  const lastFailure = signals.lastFailure
  const unfinished = !active ? signals.unfinished : undefined
  if (unfinished && (!lastFailure || unfinished.index > lastFailure.index)) {
    add('startup', 'fail', `Last unfinished startup phase: ${unfinished.phase} (begin without complete/fail; service not active); run agentic-remote logs --why`)
  } else if (lastFailure) {
    add('startup', active ? 'warn' : 'fail', `Last failed startup phase: ${lastFailure.phase}${active ? ' (service is now active)' : ''}; run agentic-remote logs --why`)
  } else {
    add('startup', 'ok', 'No failed or unfinished startup phase in the recent journal (last 2h, up to 2000 lines)')
  }
}

async function main() {
  runtimeChecks()
  const active = serviceChecks()
  await healthCheck()
  providerChecks()
  assetChecks()
  originCheck()
  tunnelChecks()
  startupCheck(active)
}
main().catch(() => add('doctor', 'fail', 'Diagnostics could not complete')).then(() => {
  if (json === 'true') console.log(JSON.stringify(results))
  else {
    const markers = { ok: '✓', warn: '!', fail: '✗', skip: '-' }
    for (const { check, status, detail } of results) console.log(`${markers[status]} ${check} [${status}]: ${detail}`)
  }
  process.exitCode = results.some((result) => result.status === 'fail') ? 1 : 0
})
NODE
}

voice_manifest_query() {
  local profile_id="$1" mode="$2"
  node - "$VOICE_PROFILE_MANIFEST" "$profile_id" "$mode" <<'NODE'
const crypto = require('node:crypto')
const fs = require('node:fs')
const path = require('node:path')

const [manifestPath, profileId, mode] = process.argv.slice(2)
let manifest
try {
  manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'))
} catch (error) {
  console.error(`agentic-remote: could not read voice profile manifest: ${error.message}`)
  process.exit(1)
}

const fail = (message) => {
  console.error(`agentic-remote: ${message}`)
  process.exit(1)
}
const printable = (value, name) => {
  if (typeof value !== 'string' || value.length === 0 || /[\0\r\n\t]/.test(value)) {
    fail(`invalid ${name} in voice profile manifest`)
  }
}
const safeName = (value, name) => {
  printable(value, name)
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(value)) {
    fail(`invalid ${name} in voice profile manifest`)
  }
}
const safeRelative = (value, name) => {
  printable(value, name)
  const normalized = path.posix.normalize(value)
  if (
    value.startsWith('/') ||
    value.includes('\\') ||
    normalized === '..' ||
    normalized.startsWith('../')
  ) {
    fail(`invalid ${name} in voice profile manifest`)
  }
}
const httpsUrl = (value, name) => {
  printable(value, name)
  let parsed
  try {
    parsed = new URL(value)
  } catch {
    fail(`invalid ${name} in voice profile manifest`)
  }
  if (parsed.protocol !== 'https:') fail(`${name} must use HTTPS`)
}

if (
  manifest?.schemaVersion !== 1 ||
  !Array.isArray(manifest.profiles) ||
  Object.hasOwn(manifest, 'defaultProfile')
) {
  fail('unsupported voice profile manifest')
}
const ids = new Set()
for (const profile of manifest.profiles) {
  safeName(profile?.id, 'profile id')
  if (ids.has(profile.id)) fail(`duplicate voice profile: ${profile.id}`)
  ids.add(profile.id)
}
const profile = manifest.profiles.find(({ id }) => id === profileId)
if (!profile) fail(`unknown voice profile: ${profileId}`)
safeName(profile.version, 'profile version')
printable(profile.description, 'profile description')
printable(profile.language, 'profile language')
printable(profile.modelType, 'profile model type')
printable(profile.modelVersion, 'profile model version')
if (!Number.isSafeInteger(profile.expandedBytes) || profile.expandedBytes <= 0) {
  fail('voice profile must declare a positive expanded byte count')
}
if (!Number.isSafeInteger(profile.entryCount) || profile.entryCount <= 0) {
  fail('voice profile must declare a positive entry count')
}
if (profile.researchOnly !== undefined && typeof profile.researchOnly !== 'boolean') {
  fail('voice profile researchOnly must be a boolean')
}
if (!Array.isArray(profile.platforms) || profile.platforms.length === 0) {
  fail('voice profile must declare platforms')
}
for (const platform of profile.platforms) safeName(platform, 'profile platform')

const requiredConfiguration = new Set([
  'AGENTIC_REMOTE_VOICE_STT_MODEL_DIR',
  'AGENTIC_REMOTE_VOICE_STT_PROFILE',
  'AGENTIC_REMOTE_VOICE_LANGUAGE',
  'AGENTIC_REMOTE_VOICE_THREADS',
  'AGENTIC_REMOTE_VOICE_ENDPOINT_MS',
  'AGENTIC_REMOTE_VOICE_TTS_MODEL',
  'AGENTIC_REMOTE_VOICE_TTS_CONFIG',
])
const ttsEngine = profile.configuration?.AGENTIC_REMOTE_VOICE_TTS_ENGINE
if (ttsEngine === 'sherpa-vits') {
  requiredConfiguration.add('AGENTIC_REMOTE_VOICE_TTS_ENGINE')
  requiredConfiguration.add('AGENTIC_REMOTE_VOICE_TTS_TOKENS')
  requiredConfiguration.add('AGENTIC_REMOTE_VOICE_TTS_DATA_DIR')
} else if (ttsEngine === undefined) {
  requiredConfiguration.add('AGENTIC_REMOTE_VOICE_TTS_BIN')
} else {
  fail(`unsupported voice TTS engine: ${ttsEngine}`)
}
const optionalConfiguration = new Set([
  'AGENTIC_REMOTE_VOICE_COMPUTER',
  'AGENTIC_REMOTE_VOICE_TTS_SPEAKER',
])
if (!profile.configuration || Array.isArray(profile.configuration)) {
  fail('voice profile configuration must be an object')
}
for (const key of requiredConfiguration) {
  if (!Object.hasOwn(profile.configuration, key)) {
    fail(`voice profile is missing ${key}`)
  }
}
for (const [key, value] of Object.entries(profile.configuration)) {
  if (!requiredConfiguration.has(key) && !optionalConfiguration.has(key)) {
    fail(`unsupported voice profile configuration key: ${key}`)
  }
  if (typeof value !== 'string' || /[\0\r\n]/.test(value)) {
    fail(`invalid voice profile configuration value: ${key}`)
  }
  if (
    key.endsWith('_DIR')
    || (key.includes('_TTS_') && key !== 'AGENTIC_REMOTE_VOICE_TTS_ENGINE')
  ) {
    safeRelative(value, key)
  }
}
if (!['zipformer', 'nemotron'].includes(profile.configuration.AGENTIC_REMOTE_VOICE_STT_PROFILE)) {
  fail('unsupported voice STT profile')
}
const threads = Number(profile.configuration.AGENTIC_REMOTE_VOICE_THREADS)
const endpointMs = Number(profile.configuration.AGENTIC_REMOTE_VOICE_ENDPOINT_MS)
if (!Number.isInteger(threads) || threads < 1 || threads > 16) {
  fail('voice threads must be an integer from 1 to 16')
}
if (!Number.isInteger(endpointMs) || endpointMs < 300 || endpointMs > 3000) {
  fail('voice endpoint must be an integer from 300 to 3000 milliseconds')
}
if (!Array.isArray(profile.notices) || profile.notices.length === 0) {
  fail('voice profile must include notices')
}
for (const notice of profile.notices) {
  printable(notice?.name, 'notice name')
  printable(notice?.license, 'notice license')
  httpsUrl(notice?.url, 'notice URL')
}
if (!Array.isArray(profile.assets) || profile.assets.length === 0) {
  fail('voice profile must include assets')
}
const assetIds = new Set()
for (const asset of profile.assets) {
  safeName(asset?.id, 'asset id')
  if (assetIds.has(asset.id)) fail(`duplicate voice asset: ${asset.id}`)
  assetIds.add(asset.id)
  safeRelative(asset.destination, 'asset destination')
  httpsUrl(asset.url, 'asset URL')
  httpsUrl(asset.licenseUrl, 'asset license URL')
  if (!Number.isSafeInteger(asset.bytes) || asset.bytes <= 0) {
    fail(`invalid byte size for voice asset: ${asset.id}`)
  }
  if (typeof asset.sha256 !== 'string' || !/^[a-f0-9]{64}$/.test(asset.sha256)) {
    fail(`invalid checksum for voice asset: ${asset.id}`)
  }
  printable(asset.language, 'asset language')
  printable(asset.modelType, 'asset model type')
  printable(asset.modelVersion, 'asset model version')
  if (asset.archive !== undefined && !['tar.gz', 'tar.bz2'].includes(asset.archive)) {
    fail(`unsupported archive type for voice asset: ${asset.id}`)
  }
  if (asset.archive !== undefined) {
    if (!Number.isSafeInteger(asset.expandedBytes) || asset.expandedBytes <= 0) {
      fail(`invalid expanded byte count for voice archive: ${asset.id}`)
    }
    if (!Number.isSafeInteger(asset.entryCount) || asset.entryCount <= 0) {
      fail(`invalid entry count for voice archive: ${asset.id}`)
    }
  } else if (asset.expandedBytes !== undefined || asset.entryCount !== undefined) {
    fail(`non-archive voice asset must not declare archive expansion metadata: ${asset.id}`)
  }
  if (asset.executable !== undefined && typeof asset.executable !== 'boolean') {
    fail(`invalid executable flag for voice asset: ${asset.id}`)
  }
}
const expandedBytes = profile.assets.reduce(
  (total, asset) => total + (asset.archive ? asset.expandedBytes : asset.bytes),
  0,
)
const entryCount = profile.assets.reduce(
  (total, asset) => total + (asset.archive ? asset.entryCount : 1),
  0,
)
const nonArchiveParents = new Set()
for (const asset of profile.assets.filter(({ archive }) => archive === undefined)) {
  const parts = asset.destination.split('/').slice(0, -1)
  for (let index = 1; index <= parts.length; index += 1) {
    nonArchiveParents.add(parts.slice(0, index).join('/'))
  }
}
if (expandedBytes !== profile.expandedBytes) {
  fail('voice profile expanded byte count does not match its assets')
}
if (
  !Number.isSafeInteger(profile.entryCount)
  || profile.entryCount < entryCount
  || profile.entryCount > entryCount + nonArchiveParents.size
) {
  fail('voice profile entry count does not match its assets')
}

if (mode === 'metadata') {
  const digest = crypto
    .createHash('sha256')
    .update(JSON.stringify(profile))
    .digest('hex')
  console.log(profile.version)
  console.log(digest)
  console.log(profile.platforms.join(','))
  console.log(profile.researchOnly === true ? '1' : '0')
  console.log(profile.expandedBytes)
  console.log(profile.entryCount)
} else if (mode === 'assets') {
  for (const asset of profile.assets) {
    console.log([
      asset.id,
      asset.destination,
      asset.url,
      asset.bytes,
      asset.sha256,
      asset.archive ?? '',
      asset.expandedBytes ?? '',
      asset.entryCount ?? '',
      asset.executable === true ? '1' : '0',
    ].join('\x1f'))
  }
} else if (mode === 'configuration') {
  for (const [key, value] of Object.entries(profile.configuration)) {
    console.log(`${key}=${value}`)
  }
} else if (mode === 'notices') {
  console.log(`Oracle voice profile: ${profile.id}`)
  console.log(`Version: ${profile.version}`)
  console.log(`Language: ${profile.language}`)
  if (profile.researchOnly === true) {
    console.log('Use restriction: research-only profile; review the full ancestry below.')
  }
  console.log('')
  console.log('Licenses and notices:')
  for (const notice of profile.notices) {
    console.log(`- ${notice.name}: ${notice.license}`)
    console.log(`  ${notice.url}`)
  }
  console.log('')
  console.log('Pinned assets:')
  for (const asset of profile.assets) {
    console.log(`- ${asset.id}: ${asset.bytes} bytes; ${asset.licenseUrl}`)
  }
} else if (mode === 'profile-json') {
  console.log(`${JSON.stringify(profile, null, 2)}\n`)
} else {
  fail(`unsupported voice manifest query: ${mode}`)
}
NODE
}

voice_download_asset() {
  local asset_id="$1" url="$2" expected_bytes="$3" destination="$4"
  local attempt curl_status limiter_status
  for attempt in 1 2 3; do
    rm -f -- "$destination"
    set +e
    curl \
      --fail \
      --location \
      --silent \
      --show-error \
      --proto '=https' \
      --proto-redir '=https' \
      --connect-timeout 15 \
      --max-time 600 \
      "$url" |
      node -e '
        const fs = require("node:fs")
        const [destination, expectedText] = process.argv.slice(1)
        const expected = Number(expectedText)
        const output = fs.openSync(destination, "wx", 0o600)
        let written = 0
        let closed = false
        const close = () => {
          if (closed) return
          closed = true
          fs.closeSync(output)
        }
        process.stdin.on("data", (chunk) => {
          written += chunk.length
          if (written > expected) {
            close()
            fs.rmSync(destination, { force: true })
            process.exitCode = 65
            process.stdin.destroy()
            return
          }
          fs.writeSync(output, chunk)
        })
        process.stdin.on("end", () => {
          close()
          if (written !== expected) {
            fs.rmSync(destination, { force: true })
            process.exitCode = 66
          }
        })
        process.stdin.on("error", () => {
          close()
          fs.rmSync(destination, { force: true })
          if (!process.exitCode) process.exitCode = 67
        })
      ' "$destination" "$expected_bytes"
    local pipeline_status=("${PIPESTATUS[@]}")
    set -e
    curl_status="${pipeline_status[0]}"
    limiter_status="${pipeline_status[1]}"
    if [[ "$limiter_status" == 65 ]]; then
      die "download for $asset_id exceeded the pinned ${expected_bytes}-byte limit"
    fi
    if [[ "$curl_status" == 0 && "$limiter_status" == 0 ]]; then
      return
    fi
    rm -f -- "$destination"
    if ((attempt < 3)); then
      sleep 1
    fi
  done
  die "download failed after 3 attempts for $asset_id"
}

voice_extract_archive() {
  local archive="$1" archive_type="$2" destination="$3"
  local expected_bytes="$4" expected_entries="$5"
  python3 - \
    "$archive" \
    "$archive_type" \
    "$destination" \
    "$expected_bytes" \
    "$expected_entries" <<'PY'
import os
from pathlib import Path, PurePosixPath
import sys
import tarfile

(
    archive_path,
    archive_type,
    destination_text,
    expected_bytes_text,
    expected_entries_text,
) = sys.argv[1:]
destination = Path(destination_text)
expected_bytes = int(expected_bytes_text)
expected_entries = int(expected_entries_text)
archive_modes = {
    "tar.gz": "r|gz",
    "tar.bz2": "r|bz2",
}

def fail(message):
    raise SystemExit(f"agentic-remote: {message}")

def normalized_member(member):
    if "\0" in member.name or "\\" in member.name:
        fail(f"unsafe archive path: {member.name}")
    relative = PurePosixPath(member.name)
    if relative.is_absolute() or ".." in relative.parts:
        fail(f"unsafe archive path: {member.name}")
    normalized = str(relative)
    if normalized in ("", "."):
        if not member.isdir():
            fail(f"unsafe archive path: {member.name}")
        return relative, normalized
    return relative, normalized

try:
    mode = archive_modes.get(archive_type)
    if mode is None:
        fail(f"unsupported archive type: {archive_type}")
    destination.mkdir(parents=True, exist_ok=True)
    root = destination.resolve()
    entries = 0
    expanded = 0
    declared = set()
    path_types = {}
    with tarfile.open(archive_path, mode) as archive:
        for member in archive:
            entries += 1
            if entries > expected_entries:
                fail(f"archive entry count exceeds pinned {expected_entries}")
            if not (member.isfile() or member.isdir()):
                fail("voice archives may contain only regular files and directories")
            if member.sparse is not None or any(
                key.startswith("GNU.sparse") for key in member.pax_headers
            ):
                fail("voice archives must not contain sparse files")
            expanded += member.size
            if expanded > expected_bytes:
                fail(f"archive expanded bytes exceed pinned {expected_bytes}")

            relative, normalized = normalized_member(member)
            if normalized in declared:
                fail(f"duplicate archive path: {member.name}")
            declared.add(normalized)
            if normalized in ("", "."):
                continue

            parts = relative.parts
            for index in range(1, len(parts)):
                ancestor = str(PurePosixPath(*parts[:index]))
                if path_types.get(ancestor) == "file":
                    fail(f"archive path type conflict: {member.name}")
                path_types.setdefault(ancestor, "directory")
            member_type = "directory" if member.isdir() else "file"
            previous_type = path_types.get(normalized)
            if previous_type is not None and previous_type != member_type:
                fail(f"archive path type conflict: {member.name}")
            path_types[normalized] = member_type

            target = destination.joinpath(*relative.parts)
            parent = target.parent
            parent.mkdir(parents=True, exist_ok=True)
            resolved_parent = parent.resolve()
            if os.path.commonpath((root, resolved_parent)) != str(root):
                fail(f"unsafe archive path: {member.name}")
            if member.isdir():
                target.mkdir(mode=0o755, exist_ok=True)
                if not target.is_dir() or target.is_symlink():
                    fail(f"archive directory is not safe: {member.name}")
                continue

            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            if hasattr(os, "O_NOFOLLOW"):
                flags |= os.O_NOFOLLOW
            try:
                descriptor = os.open(target, flags, 0o644)
            except OSError as error:
                fail(f"could not create archive file {member.name}: {error}")
            source = archive.extractfile(member)
            if source is None:
                os.close(descriptor)
                fail(f"could not read archive file: {member.name}")
            copied = 0
            try:
                with os.fdopen(descriptor, "wb") as output:
                    while True:
                        chunk = source.read(min(1024 * 1024, member.size - copied + 1))
                        if not chunk:
                            break
                        copied += len(chunk)
                        if copied > member.size:
                            fail(f"archive file exceeded declared size: {member.name}")
                        output.write(chunk)
            finally:
                source.close()
            if copied != member.size:
                fail(
                    f"archive file size mismatch for {member.name}: "
                    f"expected {member.size}, got {copied}"
                )

        if entries != expected_entries:
            fail(
                f"archive entry count mismatch: expected {expected_entries}, "
                f"got {entries}"
            )
        if expanded != expected_bytes:
            fail(
                f"archive expanded byte mismatch: expected {expected_bytes}, "
                f"got {expanded}"
            )
except (tarfile.TarError, OSError) as error:
    fail(
        f"could not validate or extract {archive_type} voice archive "
        f"(compression must match the manifest): {error}"
    )
PY
}

voice_validate_staging_tree() {
  local staging="$1" expected_bytes="$2" expected_entries="$3"
  python3 - "$staging" "$expected_bytes" "$expected_entries" <<'PY'
import os
from pathlib import Path
import stat
import sys

root_text, expected_bytes_text, expected_entries_text = sys.argv[1:]
root = Path(root_text).resolve()
expected_bytes = int(expected_bytes_text)
expected_entries = int(expected_entries_text)
entries = 0
expanded = 0

def fail(message):
    raise SystemExit(f"agentic-remote: {message}")

for directory, names, files in os.walk(root, topdown=True, followlinks=False):
    directory_path = Path(directory)
    for name in [*names, *files]:
        candidate = directory_path / name
        metadata = candidate.lstat()
        if stat.S_ISLNK(metadata.st_mode):
            fail(f"voice staging tree contains a symbolic link: {candidate}")
        if not (stat.S_ISDIR(metadata.st_mode) or stat.S_ISREG(metadata.st_mode)):
            fail(f"voice staging tree contains a special entry: {candidate}")
        if os.path.commonpath((root, candidate.resolve())) != str(root):
            fail(f"voice staging tree escapes its root: {candidate}")
        entries += 1
        if stat.S_ISREG(metadata.st_mode):
            expanded += metadata.st_size

if entries != expected_entries:
    fail(
        f"voice profile entry count mismatch: expected {expected_entries}, "
        f"got {entries}"
    )
if expanded != expected_bytes:
    fail(
        f"voice profile expanded byte mismatch: expected {expected_bytes}, "
        f"got {expanded}"
    )
PY
}

voice_profile_tree_digest() {
  local profile_root="$1"
  python3 - "$profile_root" <<'PY'
import hashlib
from pathlib import Path
import stat
import sys

root = Path(sys.argv[1]).resolve()
digest = hashlib.sha256()
excluded = {".profile-sha256", ".profile-tree-sha256"}

def fail(message):
    raise SystemExit(f"agentic-remote: {message}")

for candidate in sorted(root.rglob("*"), key=lambda path: path.relative_to(root).as_posix()):
    relative = candidate.relative_to(root).as_posix()
    if relative in excluded:
        continue
    metadata = candidate.lstat()
    if stat.S_ISLNK(metadata.st_mode):
        fail(f"voice profile contains a symbolic link: {candidate}")
    if stat.S_ISDIR(metadata.st_mode):
        kind = b"directory"
    elif stat.S_ISREG(metadata.st_mode):
        kind = b"file"
    else:
        fail(f"voice profile contains a special entry: {candidate}")
    digest.update(kind + b"\0")
    digest.update(relative.encode("utf-8") + b"\0")
    digest.update(f"{stat.S_IMODE(metadata.st_mode):o}".encode("ascii") + b"\0")
    if kind == b"file":
        digest.update(str(metadata.st_size).encode("ascii") + b"\0")
        with candidate.open("rb") as source:
            while chunk := source.read(1024 * 1024):
                digest.update(chunk)
print(digest.hexdigest())
PY
}

activate_voice_profile() {
  local voice_root="$1" profile_id="$2" version="$3"
  local active_root="$voice_root/active"
  local temporary_link="$active_root/.${profile_id}.current.$$"
  mkdir -p "$active_root"
  [[ ! -e "$active_root/$profile_id" || -L "$active_root/$profile_id" ]] ||
    die "voice active path is not a symbolic link: $active_root/$profile_id"
  VOICE_INSTALL_CLEANUP_LINK="$temporary_link"
  rm -f -- "$temporary_link"
  ln -s "../profiles/$profile_id/$version" "$temporary_link"
  voice_install_fault before-active-replace
  if ! mv -Tf "$temporary_link" "$active_root/$profile_id"; then
    rm -f -- "$temporary_link"
    die "could not activate voice profile: $profile_id $version"
  fi
  voice_install_fault after-active-replace
  VOICE_INSTALL_CLEANUP_LINK=""
}

voice_install_fault() {
  local stage="$1"
  case "${AGENTIC_REMOTE_VOICE_INSTALL_FAULT:-}" in
    "exit:$stage")
      exit 97
      ;;
    "term:$stage")
      kill -TERM "$BASHPID"
      ;;
  esac
}

cleanup_voice_install() {
  local result=$?
  trap - EXIT
  if [[ -n "$VOICE_INSTALL_CLEANUP_LINK" ]]; then
    rm -f -- "$VOICE_INSTALL_CLEANUP_LINK"
  fi
  if [[ -n "$VOICE_INSTALL_CLEANUP_PATH" &&
    ( -e "$VOICE_INSTALL_CLEANUP_PATH" || -L "$VOICE_INSTALL_CLEANUP_PATH" ) ]]; then
    rm -rf -- "$VOICE_INSTALL_CLEANUP_PATH"
  fi
  exit "$result"
}

print_voice_configuration() {
  local profile_id="$1"
  printf '\nSet these values in %s:\n' "$ENV_FILE"
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      AGENTIC_REMOTE_VOICE_STT_MODEL_DIR | \
        AGENTIC_REMOTE_VOICE_TTS_BIN | \
        AGENTIC_REMOTE_VOICE_TTS_MODEL | \
        AGENTIC_REMOTE_VOICE_TTS_CONFIG | \
        AGENTIC_REMOTE_VOICE_TTS_TOKENS | \
        AGENTIC_REMOTE_VOICE_TTS_DATA_DIR)
        value="models/oracle-voice/active/$profile_id/$value"
        ;;
    esac
    printf '%s=%s\n' "$key" "$value"
  done < <(voice_manifest_query "$profile_id" configuration)
  printf '%s\n' \
    "Oracle voice remains disabled until AGENTIC_REMOTE_ORACLE_VOICE=on is set."
}

voice_install() {
  local accept_research_only=0 profile_id=""
  while (($#)); do
    case "$1" in
      --accept-research-only)
        [[ "$accept_research_only" == 0 ]] ||
          die "voice-install received --accept-research-only more than once"
        accept_research_only=1
        ;;
      -*)
        die "unknown voice-install option: $1"
        ;;
      *)
        [[ -z "$profile_id" ]] ||
          die "voice-install requires exactly one profile"
        profile_id="$1"
        ;;
    esac
    shift
  done
  [[ -n "$profile_id" ]] ||
    die "voice-install requires one profile and optional --accept-research-only"
  require_command node
  require_command curl
  require_command flock
  require_command python3
  require_command sha256sum
  require_command stat

  local metadata version profile_digest platforms research_only
  local profile_expanded_bytes profile_entry_count
  metadata="$(voice_manifest_query "$profile_id" metadata)"
  version="$(sed -n '1p' <<<"$metadata")"
  profile_digest="$(sed -n '2p' <<<"$metadata")"
  platforms="$(sed -n '3p' <<<"$metadata")"
  research_only="$(sed -n '4p' <<<"$metadata")"
  profile_expanded_bytes="$(sed -n '5p' <<<"$metadata")"
  profile_entry_count="$(sed -n '6p' <<<"$metadata")"
  local platform
  case "$(uname -s):$(uname -m)" in
    Linux:x86_64 | Linux:amd64)
      platform="linux-x64"
      ;;
    *)
      die "voice profile $profile_id has no asset for $(uname -s) $(uname -m)"
      ;;
  esac
  [[ ",$platforms," == *",$platform,"* ]] ||
    die "voice profile $profile_id does not support $platform"

  local notices
  notices="$(voice_manifest_query "$profile_id" notices)"
  printf '%s\n' "$notices"
  if [[ "$research_only" == 1 && "$accept_research_only" != 1 ]]; then
    die "voice profile $profile_id is research-only; rerun with --accept-research-only after reviewing the notices"
  fi

  local data_directory voice_root profiles_root final_directory marker tree_marker
  data_directory="${AGENTIC_REMOTE_DATA_DIR:-$(config_value AGENTIC_REMOTE_DATA_DIR)}"
  data_directory="${data_directory:-$HOME/.agentic-remote}"
  voice_root="$data_directory/models/oracle-voice"
  profiles_root="$voice_root/profiles/$profile_id"
  final_directory="$profiles_root/$version"
  marker="$final_directory/.profile-sha256"
  tree_marker="$final_directory/.profile-tree-sha256"
  mkdir -p "$profiles_root" "$voice_root/locks"
  trap cleanup_voice_install EXIT

  local lock_file="$voice_root/locks/$profile_id.lock"
  local lock_fd
  exec {lock_fd}>"$lock_file"
  flock -w 600 "$lock_fd" ||
    die "timed out waiting for voice profile publication lock: $profile_id"
  if [[ -e "$final_directory" || -L "$final_directory" ]]; then
    [[ -d "$final_directory" && ! -L "$final_directory" ]] ||
      die "voice profile version path is not a directory: $profile_id $version"
    [[ -f "$marker" && ! -L "$marker" && "$(cat "$marker")" == "$profile_digest" ]] ||
      die "voice profile version already exists with different contents: $profile_id $version"
    [[ -f "$tree_marker" && ! -L "$tree_marker" ]] ||
      die "voice profile integrity check failed: $profile_id $version"
    [[ "$(voice_profile_tree_digest "$final_directory")" == "$(cat "$tree_marker")" ]] ||
      die "voice profile integrity check failed: $profile_id $version"
    activate_voice_profile "$voice_root" "$profile_id" "$version"
    [[ "$(readlink -f -- "$voice_root/active/$profile_id")" == "$final_directory" ]] ||
      die "voice profile activation could not be confirmed: $profile_id $version"
    flock -u "$lock_fd"
    trap - EXIT
    printf 'Voice profile %s %s is already installed.\n' "$profile_id" "$version"
    print_voice_configuration "$profile_id"
    return
  fi
  flock -u "$lock_fd"

  local staging="" attempt
  for attempt in {1..20}; do
    staging="$voice_root/.staging-${profile_id}-${version}.$$-${RANDOM}"
    if mkdir -m 0700 -- "$staging" 2>/dev/null; then
      break
    fi
    staging=""
  done
  [[ -n "$staging" ]] || die "could not create voice installation staging directory"
  VOICE_INSTALL_CLEANUP_PATH="$staging"
  mkdir -p "$staging/.downloads"

  local asset_id destination url expected_bytes expected_sha archive
  local expected_expanded_bytes expected_entry_count executable
  local downloaded actual_bytes actual_sha extraction_directory target
  while IFS=$'\x1f' read -r \
    asset_id destination url expected_bytes expected_sha archive \
    expected_expanded_bytes expected_entry_count executable; do
    downloaded="$staging/.downloads/$asset_id"
    printf 'Downloading %s (%s bytes)...\n' "$asset_id" "$expected_bytes"
    voice_download_asset "$asset_id" "$url" "$expected_bytes" "$downloaded"
    actual_bytes="$(stat -c %s "$downloaded")"
    [[ "$actual_bytes" == "$expected_bytes" ]] ||
      die "byte-size mismatch for $asset_id: expected $expected_bytes, got $actual_bytes"
    actual_sha="$(sha256sum "$downloaded" | awk '{print $1}')"
    [[ "$actual_sha" == "$expected_sha" ]] ||
      die "checksum mismatch for $asset_id: expected $expected_sha, got $actual_sha"

    if [[ -n "$archive" ]]; then
      extraction_directory="$staging/$destination"
      voice_extract_archive \
        "$downloaded" \
        "$archive" \
        "$extraction_directory" \
        "$expected_expanded_bytes" \
        "$expected_entry_count"
    else
      target="$staging/$destination"
      mkdir -p "$(dirname "$target")"
      [[ ! -e "$target" && ! -L "$target" ]] ||
        die "voice asset destination already exists: $destination"
      cp -- "$downloaded" "$target"
      if [[ "$executable" == "1" ]]; then
        chmod 0755 "$target"
      fi
    fi
  done < <(voice_manifest_query "$profile_id" assets)

  rm -rf -- "$staging/.downloads"
  voice_validate_staging_tree \
    "$staging" \
    "$profile_expanded_bytes" \
    "$profile_entry_count"
  printf '%s\n' "$notices" >"$staging/NOTICES.txt"
  voice_manifest_query "$profile_id" profile-json >"$staging/PROFILE.json"
  voice_profile_tree_digest "$staging" >"$staging/.profile-tree-sha256"
  printf '%s\n' "$profile_digest" >"$staging/.profile-sha256"

  flock -w 600 "$lock_fd" ||
    die "timed out waiting for voice profile publication lock: $profile_id"

  if [[ -e "$final_directory" || -L "$final_directory" ]]; then
    [[ -d "$final_directory" && ! -L "$final_directory" ]] ||
      die "voice profile version path is not a directory: $profile_id $version"
    [[ -f "$marker" && ! -L "$marker" && "$(cat "$marker")" == "$profile_digest" ]] ||
      die "voice profile version already exists with different contents: $profile_id $version"
    [[ -f "$tree_marker" && ! -L "$tree_marker" ]] ||
      die "voice profile integrity check failed: $profile_id $version"
    [[ "$(voice_profile_tree_digest "$final_directory")" == "$(cat "$tree_marker")" ]] ||
      die "voice profile integrity check failed: $profile_id $version"
    rm -rf -- "$staging"
    VOICE_INSTALL_CLEANUP_PATH=""
    activate_voice_profile "$voice_root" "$profile_id" "$version"
    [[ "$(readlink -f -- "$voice_root/active/$profile_id")" == "$final_directory" ]] ||
      die "voice profile activation could not be confirmed: $profile_id $version"
    trap - EXIT
    printf 'Voice profile %s %s is already installed.\n' "$profile_id" "$version"
    print_voice_configuration "$profile_id"
    return
  fi

  voice_install_fault before-final-rename
  mv -T -- "$staging" "$final_directory"
  VOICE_INSTALL_CLEANUP_PATH="$final_directory"
  voice_install_fault after-final-rename
  [[ -f "$marker" && "$(cat "$marker")" == "$profile_digest" ]] ||
    die "voice profile publication marker could not be confirmed: $profile_id $version"
  [[ -f "$tree_marker" &&
    "$(voice_profile_tree_digest "$final_directory")" == "$(cat "$tree_marker")" ]] ||
    die "voice profile integrity check failed after publication: $profile_id $version"
  VOICE_INSTALL_CLEANUP_PATH=""
  activate_voice_profile "$voice_root" "$profile_id" "$version"
  [[ "$(readlink -f -- "$voice_root/active/$profile_id")" == "$final_directory" ]] ||
    die "voice profile activation could not be confirmed: $profile_id $version"
  trap - EXIT

  printf 'Installed and activated voice profile %s %s.\n' "$profile_id" "$version"
  print_voice_configuration "$profile_id"
}

append_preserved_voice_configuration() {
  local destination="$1"
  declare -A voice_configuration=()
  local line key value
  if [[ -f "$ENV_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == *=* ]] || continue
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        AGENTIC_REMOTE_ORACLE_VOICE | AGENTIC_REMOTE_VOICE_*)
          voice_configuration["$key"]="$value"
          ;;
      esac
    done <"$ENV_FILE"
  fi
  while IFS= read -r key; do
    case "$key" in
      AGENTIC_REMOTE_ORACLE_VOICE | AGENTIC_REMOTE_VOICE_*)
        voice_configuration["$key"]="${!key}"
        ;;
    esac
  done < <(compgen -e)
  if ((${#voice_configuration[@]} == 0)); then
    return
  fi
  while IFS= read -r key; do
    printf '%s=%s\n' "$key" "${voice_configuration[$key]}" >>"$destination"
  done < <(printf '%s\n' "${!voice_configuration[@]}" | LC_ALL=C sort)
}

validate_host() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "host must be an IPv4 address or hostname"
}

validate_port() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "port must be a number"
  ((10#$1 >= 1 && 10#$1 <= 65535)) || die "port must be between 1 and 65535"
}

validate_role() {
  [[ "$1" == "hub" || "$1" == "node" ]] || die "role must be hub or node"
}

validate_name() {
  [[ -n "$1" && "$1" != *$'\r'* && "$1" != *$'\n'* ]] ||
    die "name must be a single non-empty line"
}

validate_release_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] ||
    die "release ID contains unsupported characters"
  [[ "$1" != current ]] ||
    die "release ID current is reserved for the active-release pointer"
  local inventory="${2:-$CONFIG_DIR/releases}"
  if [[ -d "$inventory" ]]; then
    inventory="$(readlink -f -- "$inventory")" ||
      die "could not resolve the release inventory"
  fi
  [[ ! -e "$inventory/$1" && ! -L "$inventory/$1" ]] ||
    die "release already exists: $1"
  [[ ! -e "$inventory.rejected/$1" && ! -L "$inventory.rejected/$1" ]] ||
    die "release already exists in the rejected archive: $1"
}

systemd_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

write_service() {
  local pnpm_bin node_bin copilot_bin runtime_path temporary
  [[ "$REPO_ROOT" != *[[:space:]]* ]] ||
    die "repository paths containing whitespace are not supported by systemd setup"
  pnpm_bin="$(command -v pnpm)"
  node_bin="$(command -v node)"
  copilot_bin="$(command -v copilot)"
  runtime_path="$(dirname "$node_bin"):$(dirname "$pnpm_bin"):$(dirname "$copilot_bin"):/usr/local/bin:/usr/bin:/bin"
  temporary="$(mktemp "$SYSTEMD_DIR/.agentic-remote.service.XXXXXX")"

  cat >"$temporary" <<EOF
[Unit]
Description=Agentic Remote
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$CONFIG_DIR/releases/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=$(systemd_quote "PATH=$runtime_path")
Environment=$(systemd_quote "COPILOT_BIN=$copilot_bin")
EnvironmentFile=-$ENV_FILE
ExecStart=$(systemd_quote "$node_bin") --import tsx server/index.ts
KillMode=process
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
EOF

  install -m 0644 "$temporary" "$SERVICE_FILE"
  rm -f -- "$temporary"
}

refresh_promotion_lifecycle_if_installed() {
  local promotion_profile="$CONFIG_DIR/promotion.env"
  local promotion_service="$SYSTEMD_DIR/agentic-remote-promotion-monitor.service"
  local promotion_timer="$SYSTEMD_DIR/agentic-remote-promotion-monitor.timer"
  local promotion_monitor="$HOME/.local/lib/agentic-remote/promotion-monitor"
  local promotion_setup="$REPO_ROOT/bin/agentic-remote-promotion-setup"
  if [[ ! -f "$promotion_service" &&
    ! -f "$promotion_timer" &&
    ! -f "$promotion_monitor" ]]; then
    return 0
  fi
  if [[ ! -f "$promotion_profile" ||
    ! -f "$promotion_service" ||
    ! -f "$promotion_timer" ||
    ! -f "$promotion_monitor" ]]; then
    die "promotion lifecycle installation is incomplete; run promotion setup install or uninstall"
  fi
  [[ -x "$promotion_setup" ]] ||
    die "promotion lifecycle is installed, but this release cannot refresh it"
  AGENTIC_REMOTE_PROMOTION_HOME="$HOME" "$promotion_setup" refresh ||
    die "the release was published, but the installed promotion lifecycle could not be refreshed"
}

derived_origins() {
  local derived_host="$1" derived_port="$2"
  if [[ -z "$derived_host" || -z "$derived_port" ]]; then
    return 0
  fi
  printf 'http://%s:%s,http://localhost:%s,http://127.0.0.1:%s' \
    "$derived_host" "$derived_port" "$derived_port" "$derived_port"
}

sync_release_paths() {
  node -e '
    const fs = require("node:fs");
    const path = require("node:path");
    const [mode, ...directories] = process.argv.slice(1);
    if (!["tree", "directories"].includes(mode) || !directories.length) {
      throw new Error("invalid release sync operation");
    }
    const sync = (entry, directory) => {
      const fd = fs.openSync(entry, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW |
        (directory ? fs.constants.O_DIRECTORY : 0));
      try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
    };
    const syncTree = (entry) => {
      const stat = fs.lstatSync(entry);
      if (stat.isSymbolicLink()) return;
      if (stat.isDirectory()) {
        for (const name of fs.readdirSync(entry)) syncTree(path.join(entry, name));
      } else if (!stat.isFile()) {
        throw new Error(`unsupported release entry: ${entry}`);
      }
      sync(entry, stat.isDirectory());
    };
    for (const directory of directories) {
      if (!fs.lstatSync(directory).isDirectory()) {
        throw new Error(`release sync requires a real directory: ${directory}`);
      }
      if (mode === "tree") syncTree(directory);
      else sync(directory, true);
    }
  ' "$@"
}

quarantine_inactive_rejected_releases() {
  local releases_dir current_release failed_release quarantine_root target
  releases_dir="$CONFIG_DIR/releases"
  [[ -d "$releases_dir" ]] || return 0
  releases_dir="$(readlink -f -- "$releases_dir")" || return 1
  [[ -r "$releases_dir" && -x "$releases_dir" ]] || return 1
  if [[ ! -e "$releases_dir/current" && ! -L "$releases_dir/current" ]]; then
    return 0
  fi
  current_release="$(readlink -f -- "$releases_dir/current")" || return 1
  [[ -d "$current_release" && -r "$current_release" && -x "$current_release" ]] || return 1
  [[ ! -e "$current_release/.promotion-failed" ]] || return 0
  quarantine_root="$releases_dir.rejected"
  for failed_release in "$releases_dir"/* "$releases_dir"/.[!.]* "$releases_dir"/..?*; do
    [[ -d "$failed_release" && ! -L "$failed_release" ]] || continue
    [[ -r "$failed_release" && -x "$failed_release" ]] || return 1
    [[ -e "$failed_release/.promotion-failed" ]] || continue
    [[ "$failed_release" != "$current_release" &&
      "$(readlink -f -- "$failed_release")" == "$failed_release" &&
      "$(readlink -f -- "$releases_dir/current")" == "$current_release" &&
      ! -e "$current_release/.promotion-failed" ]] || return 1
    [[ ! -L "$quarantine_root" ]] || return 1
    mkdir -p -- "$quarantine_root" || return 1
    target="$quarantine_root/$(basename -- "$failed_release")"
    [[ ! -e "$target" && ! -L "$target" ]] || return 1
    node -e '
      const fs = require("node:fs");
      const fd = fs.openSync(process.argv[1], fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
      try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
      fs.renameSync(process.argv[1], process.argv[2]);
    ' \
      "$failed_release" "$target" || return 1
    printf 'Quarantined rejected release at %s\n' "$target"
  done
  if [[ -e "$quarantine_root" || -L "$quarantine_root" ]]; then
    sync_release_paths directories "$releases_dir" "$quarantine_root"
  else
    sync_release_paths directories "$releases_dir"
  fi
}

publish_release() {
  local releases_dir release_id release_dir temporary_link staging_dir staging_parent
  release_id="${1:-$(date -u +%Y%m%dT%H%M%SZ)-$$-${RANDOM}}"
  validate_release_id "$release_id"
  [[ -s "$REPO_ROOT/dist/build-info.json" ]] ||
    die "production build identity is missing; rebuild the app"
  releases_dir="$CONFIG_DIR/releases"
  mkdir -p "$releases_dir"
  releases_dir="$(readlink -f -- "$releases_dir")"
  quarantine_inactive_rejected_releases ||
    die "could not quarantine inactive rejected releases before publication"
  release_dir="$releases_dir/$release_id"
  temporary_link="$releases_dir/.current-$release_id"
  validate_release_id "$release_id" "$releases_dir"
  staging_parent="$(readlink -f -- "$CONFIG_DIR")"
  staging_dir="$(mktemp -d "$staging_parent/.release-stage.XXXXXX")"
  (
    published=0
    activated=0
    cleanup_publication() {
      local result=$? current=""
      trap - EXIT
      if [[ "$result" != 0 && "$published" == 1 && "$activated" == 0 ]]; then
        if [[ ! -e "$releases_dir/current" && ! -L "$releases_dir/current" ]] ||
          { current="$(readlink -f -- "$releases_dir/current")" &&
            [[ "$current" != "$release_dir" ]]; }; then
          rm -rf -- "$release_dir"
        else
          printf 'Warning: retained release %s because activation is indeterminate.\n' "$release_dir" >&2
        fi
      fi
      rm -rf -- "$staging_dir"
      rm -f -- "$temporary_link"
      exit "$result"
    }
    trap cleanup_publication EXIT
    mkdir -p "$staging_dir/dist" "$staging_dir/node_modules"
    # Stage outside rollback inventory, including when a copy is interrupted.
    cp -a "$REPO_ROOT/dist/." "$staging_dir/dist/"
    cp -a \
      "$REPO_ROOT/server" \
      "$REPO_ROOT/shared" \
      "$REPO_ROOT/package.json" \
      "$REPO_ROOT/tsconfig.json" \
      "$REPO_ROOT/tsconfig.server.json" \
      "$staging_dir/"
    cp -a "$REPO_ROOT/node_modules/." "$staging_dir/node_modules/"
    sync_release_paths tree "$staging_dir"
    node -e 'require("node:fs").renameSync(process.argv[1], process.argv[2])' \
      "$staging_dir" "$release_dir"
    published=1
    sync_release_paths directories "$releases_dir" "$staging_parent"
    ln -s "$release_dir" "$temporary_link"
    mv -Tf "$temporary_link" "$releases_dir/current"
    [[ "$(readlink -f -- "$releases_dir/current")" == "$release_dir" ]] ||
      die "release activation did not install $release_id"
    sync_release_paths directories "$releases_dir"
    activated=1
  )

  # Always retain current, regardless of directory timestamps.
  find "$releases_dir" -mindepth 1 -maxdepth 1 -type d \
    ! -exec test -e '{}/.promotion-failed' \; -printf '%T@ %p\0' |
    sort -z -nr |
    {
      retained=0
      while IFS= read -r -d '' entry; do
        old_release="${entry#* }"
        [[ "$old_release" != "$release_dir" ]] || continue
        retained=$((retained + 1))
        if ((retained > 2)); then
          rm -rf -- "$old_release"
        fi
      done
    }
  sync_release_paths directories "$releases_dir"
}

enable_linger() {
  local linger
  linger="$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)"
  if [[ "$linger" == "yes" ]]; then
    return
  fi
  if ! loginctl enable-linger "$USER" 2>/dev/null; then
    printf '%s\n' \
      "Warning: boot startup requires an administrator to run:" \
      "  sudo loginctl enable-linger $USER" >&2
  fi
}

setup_service() {
  local host="" port="" role="" name="" data_directory="" allowed_origins=""
  local allowed_roots=""
  local transcription_computer=""
  local devtunnel_id=""
  local release_id=""
  while (($# > 0)); do
    case "$1" in
      --host)
        (($# >= 2)) || die "--host requires a value"
        host="$2"
        shift 2
        ;;
      --port)
        (($# >= 2)) || die "--port requires a value"
        port="$2"
        shift 2
        ;;
      --role)
        (($# >= 2)) || die "--role requires a value"
        role="$2"
        shift 2
        ;;
      --name)
        (($# >= 2)) || die "--name requires a value"
        name="$2"
        shift 2
        ;;
      --release-id)
        (($# >= 2)) || die "--release-id requires a value"
        release_id="$2"
        validate_release_id "$release_id"
        shift 2
        ;;
      *)
        die "unknown setup option: $1"
        ;;
    esac
  done

  require_command node
  require_command pnpm
  require_command copilot
  require_command systemctl
  require_command loginctl

  host="${host:-$(config_value HOST)}"
  port="${port:-$(config_value PORT)}"
  role="${role:-$(config_value AGENTIC_REMOTE_ROLE)}"
  name="${name:-$(config_value AGENTIC_REMOTE_NODE_NAME)}"
  data_directory="$(config_value AGENTIC_REMOTE_DATA_DIR)"
  allowed_roots="${AGENTIC_REMOTE_ALLOWED_ROOTS:-$(config_value AGENTIC_REMOTE_ALLOWED_ROOTS)}"
  transcription_computer="${AGENTIC_REMOTE_TRANSCRIPTION_COMPUTER:-$(config_value AGENTIC_REMOTE_TRANSCRIPTION_COMPUTER)}"
  devtunnel_id="${AGENTIC_REMOTE_DEVTUNNEL_ID:-$(config_value AGENTIC_REMOTE_DEVTUNNEL_ID)}"
  manager_switch="${AGENTIC_REMOTE_MANAGER:-$(config_value AGENTIC_REMOTE_MANAGER)}"
  manager_model="${AGENTIC_REMOTE_MANAGER_MODEL:-$(config_value AGENTIC_REMOTE_MANAGER_MODEL)}"
  manager_effort="${AGENTIC_REMOTE_MANAGER_REASONING_EFFORT:-$(config_value AGENTIC_REMOTE_MANAGER_REASONING_EFFORT)}"
  manager_structured_memory="${AGENTIC_REMOTE_MANAGER_STRUCTURED_MEMORY:-$(config_value AGENTIC_REMOTE_MANAGER_STRUCTURED_MEMORY)}"
  local previous_host previous_port previous_origins
  previous_host="$(config_value HOST)"
  previous_port="$(config_value PORT)"
  previous_origins="$(config_value AGENTIC_REMOTE_ALLOWED_ORIGINS)"
  allowed_origins="${AGENTIC_REMOTE_ALLOWED_ORIGINS:-}"
  host="${host:-127.0.0.1}"
  port="${port:-4317}"
  role="${role:-hub}"
  name="${name:-$(hostname)}"
  validate_host "$host"
  validate_port "$port"
  validate_role "$role"
  validate_name "$name"

  if [[ -z "$allowed_origins" && -n "$previous_origins" ]]; then
    # Keep a user-supplied allowlist, but regenerate one this script derived so
    # a changed --host/--port does not leave the hub rejecting its new address.
    if [[ "$previous_origins" != "$(derived_origins "$previous_host" "$previous_port")" ]]; then
      allowed_origins="$previous_origins"
    fi
  fi
  if [[ -z "$allowed_origins" ]]; then
    # Keep loopback usable: an explicit list turns off the server's derived
    # loopback allowance, so the derived value has to spell it out.
    allowed_origins="$(derived_origins "$host" "$port")"
  fi

  printf 'Installing dependencies...\n'
  CI=true pnpm --dir "$REPO_ROOT" install --frozen-lockfile
  printf 'Building production app...\n'
  pnpm --dir "$REPO_ROOT" build

  mkdir -p "$SYSTEMD_DIR" "$CONFIG_DIR" "$(dirname "$COMMAND_LINK")"
  publish_release "$release_id"
  local environment_tmp
  environment_tmp="$(mktemp "$CONFIG_DIR/.environment.XXXXXX")"
  printf '%s\n' \
    "HOST=$host" \
    "PORT=$port" \
    "AGENTIC_REMOTE_ROLE=$role" \
    "AGENTIC_REMOTE_NODE_NAME=$name" \
    "AGENTIC_REMOTE_RELEASE_DIR=$CONFIG_DIR/releases/current/dist" >"$environment_tmp"
  if [[ -n "$data_directory" ]]; then
    printf 'AGENTIC_REMOTE_DATA_DIR=%s\n' "$data_directory" >>"$environment_tmp"
  fi
  if [[ -n "$allowed_roots" ]]; then
    printf 'AGENTIC_REMOTE_ALLOWED_ROOTS=%s\n' "$allowed_roots" >>"$environment_tmp"
  fi
  # A downstream host runs setup with no environment of its own, so the computer
  # assigned to transcribe has to survive from the file setup is replacing.
  if [[ -n "$transcription_computer" ]]; then
    printf 'AGENTIC_REMOTE_TRANSCRIPTION_COMPUTER=%s\n' \
      "$transcription_computer" >>"$environment_tmp"
  fi
  if [[ -n "$devtunnel_id" ]]; then
    printf 'AGENTIC_REMOTE_DEVTUNNEL_ID=%s\n' "$devtunnel_id" >>"$environment_tmp"
  fi
  # The manager agent's settings survive setup the same way.
  if [[ -n "$manager_switch" ]]; then
    printf 'AGENTIC_REMOTE_MANAGER=%s\n' "$manager_switch" >>"$environment_tmp"
  fi
  if [[ -n "$manager_model" ]]; then
    printf 'AGENTIC_REMOTE_MANAGER_MODEL=%s\n' "$manager_model" >>"$environment_tmp"
  fi
  if [[ -n "$manager_effort" ]]; then
    printf 'AGENTIC_REMOTE_MANAGER_REASONING_EFFORT=%s\n' "$manager_effort" >>"$environment_tmp"
  fi
  if [[ -n "$manager_structured_memory" ]]; then
    printf 'AGENTIC_REMOTE_MANAGER_STRUCTURED_MEMORY=%s\n' "$manager_structured_memory" >>"$environment_tmp"
  fi
  append_preserved_voice_configuration "$environment_tmp"
  printf 'AGENTIC_REMOTE_ALLOWED_ORIGINS=%s\n' "$allowed_origins" >>"$environment_tmp"
  install -m 0600 "$environment_tmp" "$ENV_FILE"
  rm -f -- "$environment_tmp"

  write_service
  ln -sfn "$REPO_ROOT/bin/agentic-remote" "$COMMAND_LINK"
  systemctl --user daemon-reload
  systemctl --user enable "$SERVICE_NAME"
  refresh_promotion_lifecycle_if_installed
  systemctl --user restart "$SERVICE_NAME"
  enable_linger
  quarantine_inactive_rejected_releases ||
    die "the new release was started, but inactive rejected releases could not be quarantined"

  if [[ "$role" == "hub" ]]; then
    printf 'Agentic Remote hub is running at http://%s:%s/\n' "$host" "$port"
  else
    printf 'Agentic Remote node is running at http://%s:%s/\n' "$host" "$port"
    printf 'Run agentic-remote pair-info to register it with a hub.\n'
  fi
}

pair_info() {
  require_command node
  local host port identity_file
  host="$(config_value HOST)"
  port="$(config_value PORT)"
  local data_directory
  data_directory="$(config_value AGENTIC_REMOTE_DATA_DIR)"
  identity_file="${data_directory:-$HOME/.agentic-remote}/node.json"
  [[ -f "$identity_file" ]] || die "node identity not found; run setup first"
  node -e '
    const fs = require("node:fs");
    const [file, host, port] = process.argv.slice(1);
    const identity = JSON.parse(fs.readFileSync(file, "utf8"));
    console.log(`Computer: ${identity.name}`);
    console.log(`Node ID:  ${identity.id}`);
    console.log(`URL:      http://${host}:${port}`);
    console.log(`Token:    ${identity.token}`);
  ' "$identity_file" "${host:-127.0.0.1}" "${port:-4317}"
}

update_service() {
  require_command git
  git -C "$REPO_ROOT" pull --ff-only
  setup_service
}

rollback_service() {
  local releases_dir current_release previous_release temporary_link
  releases_dir="$CONFIG_DIR/releases"
  [[ -d "$releases_dir" ]] || die "no previous release is available"
  quarantine_inactive_rejected_releases ||
    die "could not quarantine inactive rejected releases; the current release was not changed"
  current_release="$(readlink -f "$releases_dir/current" 2>/dev/null || true)"
  previous_release="$(
    find "$releases_dir" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\0' |
      sort -z -nr |
      while IFS= read -r -d '' entry; do
        release="${entry#* }"
        release="$(readlink -f "$release")"
        if [[ "$release" != "$current_release" &&
          ! -e "$release/.promotion-failed" ]]; then
          printf '%s\n' "$release"
          break
        fi
      done
  )"
  [[ -n "$previous_release" ]] || die "no previous release is available"
  temporary_link="$releases_dir/.current-$$"
  ln -s "$previous_release" "$temporary_link"
  mv -Tf "$temporary_link" "$releases_dir/current"
  sync_release_paths directories "$releases_dir"
  systemctl --user restart "$SERVICE_NAME"
  quarantine_inactive_rejected_releases ||
    die "the previous release was activated, but inactive rejected releases could not be quarantined"
  printf 'Rolled back to %s\n' "$(basename "$previous_release")"
}

uninstall_service() {
  systemctl --user disable --now "$SERVICE_NAME" 2>/dev/null || true
  rm -f -- "$SERVICE_FILE"
  systemctl --user daemon-reload
  if [[ -L "$COMMAND_LINK" && "$(readlink -f "$COMMAND_LINK")" == "$REPO_ROOT/bin/agentic-remote" ]]; then
    rm -f -- "$COMMAND_LINK"
  fi
  printf 'Agentic Remote service removed. Data in %s was preserved.\n' "$HOME/.agentic-remote"
}

command="${1:-help}"
if (($# > 0)); then
  shift
fi

case "$command" in
  setup)
    setup_service "$@"
    ;;
  start | stop | restart)
    (($# == 0)) || die "$command does not accept options"
    systemctl --user "$command" "$SERVICE_NAME"
    ;;
  status)
    (($# == 0)) || die "status does not accept options"
    systemctl --user --no-pager --full status "$SERVICE_NAME"
    ;;
  doctor)
    doctor "$@"
    ;;
  logs)
    logs "$@"
    ;;
  pair-info)
    (($# == 0)) || die "pair-info does not accept options"
    pair_info
    ;;
  update)
    (($# == 0)) || die "update does not accept options"
    update_service
    ;;
  rollback)
    (($# == 0)) || die "rollback does not accept options"
    rollback_service
    ;;
  voice-install)
    voice_install "$@"
    ;;
  uninstall)
    (($# == 0)) || die "uninstall does not accept options"
    uninstall_service
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    die "unknown command: $command"
    ;;
esac
