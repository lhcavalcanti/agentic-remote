#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly SERVICE_NAME="agentic-remote.service"
readonly SYSTEMD_DIR="$HOME/.config/systemd/user"
readonly SERVICE_FILE="$SYSTEMD_DIR/$SERVICE_NAME"
readonly CONFIG_DIR="$HOME/.config/agentic-remote"
readonly ENV_FILE="$CONFIG_DIR/environment"
readonly COMMAND_LINK="$HOME/.local/bin/agentic-remote"

usage() {
  cat <<'EOF'
Usage: agentic-remote <command> [options]

Commands:
  setup [--host ADDRESS] [--port PORT] [--role hub|node] [--name NAME] [--release-id ID]
      Install dependencies, build the app, install and start the user service.
  pair-info
      Print this node's URL, identity, and pairing token.
  start
      Start the service.
  stop
      Stop the service.
  restart
      Restart the service.
  status
      Show service status.
  logs
      Follow service logs.
  update
      Pull the current branch, install dependencies, build, and restart.
  rollback
      Activate the previous immutable release and restart the service.
  uninstall
      Stop and remove the service. Application data is preserved.
  help
      Show this help.
EOF
}

die() {
  printf 'agentic-remote: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

config_value() {
  local key="$1"
  if [[ ! -f "$ENV_FILE" ]]; then
    return
  fi
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1
}

validate_host() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "host must be an IPv4 address or hostname"
}

validate_port() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "port must be a number"
  ((10#$1 >= 1 && 10#$1 <= 65535)) || die "port must be between 1 and 65535"
}

validate_role() {
  [[ "$1" == "hub" || "$1" == "node" ]] || die "role must be hub or node"
}

validate_name() {
  [[ -n "$1" && "$1" != *$'\r'* && "$1" != *$'\n'* ]] ||
    die "name must be a single non-empty line"
}

validate_release_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] ||
    die "release ID contains unsupported characters"
  [[ "$1" != current ]] ||
    die "release ID current is reserved for the active-release pointer"
  local inventory="${2:-$CONFIG_DIR/releases}"
  if [[ -d "$inventory" ]]; then
    inventory="$(readlink -f -- "$inventory")" ||
      die "could not resolve the release inventory"
  fi
  [[ ! -e "$inventory/$1" && ! -L "$inventory/$1" ]] ||
    die "release already exists: $1"
  [[ ! -e "$inventory.rejected/$1" && ! -L "$inventory.rejected/$1" ]] ||
    die "release already exists in the rejected archive: $1"
}

systemd_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

write_service() {
  local pnpm_bin node_bin copilot_bin runtime_path temporary
  [[ "$REPO_ROOT" != *[[:space:]]* ]] ||
    die "repository paths containing whitespace are not supported by systemd setup"
  pnpm_bin="$(command -v pnpm)"
  node_bin="$(command -v node)"
  copilot_bin="$(command -v copilot)"
  runtime_path="$(dirname "$node_bin"):$(dirname "$pnpm_bin"):$(dirname "$copilot_bin"):/usr/local/bin:/usr/bin:/bin"
  temporary="$(mktemp "$SYSTEMD_DIR/.agentic-remote.service.XXXXXX")"

  cat >"$temporary" <<EOF
[Unit]
Description=Agentic Remote
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$CONFIG_DIR/releases/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=$(systemd_quote "PATH=$runtime_path")
Environment=$(systemd_quote "COPILOT_BIN=$copilot_bin")
EnvironmentFile=-$ENV_FILE
ExecStart=$(systemd_quote "$node_bin") --import tsx server/index.ts
KillMode=process
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
EOF

  install -m 0644 "$temporary" "$SERVICE_FILE"
  rm -f -- "$temporary"
}

refresh_promotion_lifecycle_if_installed() {
  local promotion_profile="$CONFIG_DIR/promotion.env"
  local promotion_service="$SYSTEMD_DIR/agentic-remote-promotion-monitor.service"
  local promotion_timer="$SYSTEMD_DIR/agentic-remote-promotion-monitor.timer"
  local promotion_setup="$REPO_ROOT/bin/agentic-remote-promotion-setup"
  if [[ ! -f "$promotion_profile" &&
    ! -f "$promotion_service" &&
    ! -f "$promotion_timer" ]]; then
    return 0
  fi
  [[ -x "$promotion_setup" ]] ||
    die "promotion lifecycle is installed, but this release cannot refresh it"
  AGENTIC_REMOTE_PROMOTION_HOME="$HOME" "$promotion_setup" refresh ||
    die "the release was published, but the installed promotion lifecycle could not be refreshed"
}

derived_origins() {
  local derived_host="$1" derived_port="$2"
  if [[ -z "$derived_host" || -z "$derived_port" ]]; then
    return 0
  fi
  printf 'http://%s:%s,http://localhost:%s,http://127.0.0.1:%s' \
    "$derived_host" "$derived_port" "$derived_port" "$derived_port"
}

sync_release_paths() {
  node -e '
    const fs = require("node:fs");
    const path = require("node:path");
    const [mode, ...directories] = process.argv.slice(1);
    if (!["tree", "directories"].includes(mode) || !directories.length) {
      throw new Error("invalid release sync operation");
    }
    const sync = (entry, directory) => {
      const fd = fs.openSync(entry, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW |
        (directory ? fs.constants.O_DIRECTORY : 0));
      try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
    };
    const syncTree = (entry) => {
      const stat = fs.lstatSync(entry);
      if (stat.isSymbolicLink()) return;
      if (stat.isDirectory()) {
        for (const name of fs.readdirSync(entry)) syncTree(path.join(entry, name));
      } else if (!stat.isFile()) {
        throw new Error(`unsupported release entry: ${entry}`);
      }
      sync(entry, stat.isDirectory());
    };
    for (const directory of directories) {
      if (!fs.lstatSync(directory).isDirectory()) {
        throw new Error(`release sync requires a real directory: ${directory}`);
      }
      if (mode === "tree") syncTree(directory);
      else sync(directory, true);
    }
  ' "$@"
}

quarantine_inactive_rejected_releases() {
  local releases_dir current_release failed_release quarantine_root target
  releases_dir="$CONFIG_DIR/releases"
  [[ -d "$releases_dir" ]] || return 0
  releases_dir="$(readlink -f -- "$releases_dir")" || return 1
  [[ -r "$releases_dir" && -x "$releases_dir" ]] || return 1
  if [[ ! -e "$releases_dir/current" && ! -L "$releases_dir/current" ]]; then
    return 0
  fi
  current_release="$(readlink -f -- "$releases_dir/current")" || return 1
  [[ -d "$current_release" && -r "$current_release" && -x "$current_release" ]] || return 1
  [[ ! -e "$current_release/.promotion-failed" ]] || return 0
  quarantine_root="$releases_dir.rejected"
  for failed_release in "$releases_dir"/* "$releases_dir"/.[!.]* "$releases_dir"/..?*; do
    [[ -d "$failed_release" && ! -L "$failed_release" ]] || continue
    [[ -r "$failed_release" && -x "$failed_release" ]] || return 1
    [[ -e "$failed_release/.promotion-failed" ]] || continue
    [[ "$failed_release" != "$current_release" &&
      "$(readlink -f -- "$failed_release")" == "$failed_release" &&
      "$(readlink -f -- "$releases_dir/current")" == "$current_release" &&
      ! -e "$current_release/.promotion-failed" ]] || return 1
    [[ ! -L "$quarantine_root" ]] || return 1
    mkdir -p -- "$quarantine_root" || return 1
    target="$quarantine_root/$(basename -- "$failed_release")"
    [[ ! -e "$target" && ! -L "$target" ]] || return 1
    node -e '
      const fs = require("node:fs");
      const fd = fs.openSync(process.argv[1], fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
      try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
      fs.renameSync(process.argv[1], process.argv[2]);
    ' \
      "$failed_release" "$target" || return 1
    printf 'Quarantined rejected release at %s\n' "$target"
  done
  if [[ -e "$quarantine_root" || -L "$quarantine_root" ]]; then
    sync_release_paths directories "$releases_dir" "$quarantine_root"
  else
    sync_release_paths directories "$releases_dir"
  fi
}

publish_release() {
  local releases_dir release_id release_dir temporary_link staging_dir staging_parent
  release_id="${1:-$(date -u +%Y%m%dT%H%M%SZ)-$$-${RANDOM}}"
  validate_release_id "$release_id"
  [[ -s "$REPO_ROOT/dist/build-info.json" ]] ||
    die "production build identity is missing; rebuild the app"
  releases_dir="$CONFIG_DIR/releases"
  mkdir -p "$releases_dir"
  releases_dir="$(readlink -f -- "$releases_dir")"
  quarantine_inactive_rejected_releases ||
    die "could not quarantine inactive rejected releases before publication"
  release_dir="$releases_dir/$release_id"
  temporary_link="$releases_dir/.current-$release_id"
  validate_release_id "$release_id" "$releases_dir"
  staging_parent="$(readlink -f -- "$CONFIG_DIR")"
  staging_dir="$(mktemp -d "$staging_parent/.release-stage.XXXXXX")"
  (
    published=0
    activated=0
    cleanup_publication() {
      local result=$? current=""
      trap - EXIT
      if [[ "$result" != 0 && "$published" == 1 && "$activated" == 0 ]]; then
        if [[ ! -e "$releases_dir/current" && ! -L "$releases_dir/current" ]] ||
          { current="$(readlink -f -- "$releases_dir/current")" &&
            [[ "$current" != "$release_dir" ]]; }; then
          rm -rf -- "$release_dir"
        else
          printf 'Warning: retained release %s because activation is indeterminate.\n' "$release_dir" >&2
        fi
      fi
      rm -rf -- "$staging_dir"
      rm -f -- "$temporary_link"
      exit "$result"
    }
    trap cleanup_publication EXIT
    mkdir -p "$staging_dir/dist" "$staging_dir/node_modules"
    # Stage outside rollback inventory, including when a copy is interrupted.
    cp -a "$REPO_ROOT/dist/." "$staging_dir/dist/"
    cp -a \
      "$REPO_ROOT/server" \
      "$REPO_ROOT/shared" \
      "$REPO_ROOT/package.json" \
      "$REPO_ROOT/tsconfig.json" \
      "$REPO_ROOT/tsconfig.server.json" \
      "$staging_dir/"
    cp -a "$REPO_ROOT/node_modules/." "$staging_dir/node_modules/"
    sync_release_paths tree "$staging_dir"
    node -e 'require("node:fs").renameSync(process.argv[1], process.argv[2])' \
      "$staging_dir" "$release_dir"
    published=1
    sync_release_paths directories "$releases_dir" "$staging_parent"
    ln -s "$release_dir" "$temporary_link"
    mv -Tf "$temporary_link" "$releases_dir/current"
    [[ "$(readlink -f -- "$releases_dir/current")" == "$release_dir" ]] ||
      die "release activation did not install $release_id"
    sync_release_paths directories "$releases_dir"
    activated=1
  )

  # Always retain current, regardless of directory timestamps.
  find "$releases_dir" -mindepth 1 -maxdepth 1 -type d \
    ! -exec test -e '{}/.promotion-failed' \; -printf '%T@ %p\0' |
    sort -z -nr |
    {
      retained=0
      while IFS= read -r -d '' entry; do
        old_release="${entry#* }"
        [[ "$old_release" != "$release_dir" ]] || continue
        retained=$((retained + 1))
        if ((retained > 2)); then
          rm -rf -- "$old_release"
        fi
      done
    }
  sync_release_paths directories "$releases_dir"
}

enable_linger() {
  local linger
  linger="$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)"
  if [[ "$linger" == "yes" ]]; then
    return
  fi
  if ! loginctl enable-linger "$USER" 2>/dev/null; then
    printf '%s\n' \
      "Warning: boot startup requires an administrator to run:" \
      "  sudo loginctl enable-linger $USER" >&2
  fi
}

setup_service() {
  local host="" port="" role="" name="" data_directory="" allowed_origins=""
  local allowed_roots=""
  local transcription_computer=""
  local release_id=""
  while (($# > 0)); do
    case "$1" in
      --host)
        (($# >= 2)) || die "--host requires a value"
        host="$2"
        shift 2
        ;;
      --port)
        (($# >= 2)) || die "--port requires a value"
        port="$2"
        shift 2
        ;;
      --role)
        (($# >= 2)) || die "--role requires a value"
        role="$2"
        shift 2
        ;;
      --name)
        (($# >= 2)) || die "--name requires a value"
        name="$2"
        shift 2
        ;;
      --release-id)
        (($# >= 2)) || die "--release-id requires a value"
        release_id="$2"
        validate_release_id "$release_id"
        shift 2
        ;;
      *)
        die "unknown setup option: $1"
        ;;
    esac
  done

  require_command node
  require_command pnpm
  require_command copilot
  require_command systemctl
  require_command loginctl

  host="${host:-$(config_value HOST)}"
  port="${port:-$(config_value PORT)}"
  role="${role:-$(config_value AGENTIC_REMOTE_ROLE)}"
  name="${name:-$(config_value AGENTIC_REMOTE_NODE_NAME)}"
  data_directory="$(config_value AGENTIC_REMOTE_DATA_DIR)"
  allowed_roots="${AGENTIC_REMOTE_ALLOWED_ROOTS:-$(config_value AGENTIC_REMOTE_ALLOWED_ROOTS)}"
  transcription_computer="${AGENTIC_REMOTE_TRANSCRIPTION_COMPUTER:-$(config_value AGENTIC_REMOTE_TRANSCRIPTION_COMPUTER)}"
  local previous_host previous_port previous_origins
  previous_host="$(config_value HOST)"
  previous_port="$(config_value PORT)"
  previous_origins="$(config_value AGENTIC_REMOTE_ALLOWED_ORIGINS)"
  allowed_origins="${AGENTIC_REMOTE_ALLOWED_ORIGINS:-}"
  host="${host:-127.0.0.1}"
  port="${port:-4317}"
  role="${role:-hub}"
  name="${name:-$(hostname)}"
  validate_host "$host"
  validate_port "$port"
  validate_role "$role"
  validate_name "$name"

  if [[ -z "$allowed_origins" && -n "$previous_origins" ]]; then
    # Keep a user-supplied allowlist, but regenerate one this script derived so
    # a changed --host/--port does not leave the hub rejecting its new address.
    if [[ "$previous_origins" != "$(derived_origins "$previous_host" "$previous_port")" ]]; then
      allowed_origins="$previous_origins"
    fi
  fi
  if [[ -z "$allowed_origins" ]]; then
    # Keep loopback usable: an explicit list turns off the server's derived
    # loopback allowance, so the derived value has to spell it out.
    allowed_origins="$(derived_origins "$host" "$port")"
  fi

  printf 'Installing dependencies...\n'
  CI=true pnpm --dir "$REPO_ROOT" install --frozen-lockfile
  printf 'Building production app...\n'
  pnpm --dir "$REPO_ROOT" build

  mkdir -p "$SYSTEMD_DIR" "$CONFIG_DIR" "$(dirname "$COMMAND_LINK")"
  publish_release "$release_id"
  local environment_tmp
  environment_tmp="$(mktemp "$CONFIG_DIR/.environment.XXXXXX")"
  printf '%s\n' \
    "HOST=$host" \
    "PORT=$port" \
    "AGENTIC_REMOTE_ROLE=$role" \
    "AGENTIC_REMOTE_NODE_NAME=$name" \
    "AGENTIC_REMOTE_RELEASE_DIR=$CONFIG_DIR/releases/current/dist" >"$environment_tmp"
  if [[ -n "$data_directory" ]]; then
    printf 'AGENTIC_REMOTE_DATA_DIR=%s\n' "$data_directory" >>"$environment_tmp"
  fi
  if [[ -n "$allowed_roots" ]]; then
    printf 'AGENTIC_REMOTE_ALLOWED_ROOTS=%s\n' "$allowed_roots" >>"$environment_tmp"
  fi
  # A downstream host runs setup with no environment of its own, so the computer
  # assigned to transcribe has to survive from the file setup is replacing.
  if [[ -n "$transcription_computer" ]]; then
    printf 'AGENTIC_REMOTE_TRANSCRIPTION_COMPUTER=%s\n' \
      "$transcription_computer" >>"$environment_tmp"
  fi
  printf 'AGENTIC_REMOTE_ALLOWED_ORIGINS=%s\n' "$allowed_origins" >>"$environment_tmp"
  install -m 0600 "$environment_tmp" "$ENV_FILE"
  rm -f -- "$environment_tmp"

  write_service
  ln -sfn "$REPO_ROOT/bin/agentic-remote" "$COMMAND_LINK"
  systemctl --user daemon-reload
  systemctl --user enable "$SERVICE_NAME"
  refresh_promotion_lifecycle_if_installed
  systemctl --user restart "$SERVICE_NAME"
  enable_linger
  quarantine_inactive_rejected_releases ||
    die "the new release was started, but inactive rejected releases could not be quarantined"

  if [[ "$role" == "hub" ]]; then
    printf 'Agentic Remote hub is running at http://%s:%s/\n' "$host" "$port"
  else
    printf 'Agentic Remote node is running at http://%s:%s/\n' "$host" "$port"
    printf 'Run agentic-remote pair-info to register it with a hub.\n'
  fi
}

pair_info() {
  require_command node
  local host port identity_file
  host="$(config_value HOST)"
  port="$(config_value PORT)"
  local data_directory
  data_directory="$(config_value AGENTIC_REMOTE_DATA_DIR)"
  identity_file="${data_directory:-$HOME/.agentic-remote}/node.json"
  [[ -f "$identity_file" ]] || die "node identity not found; run setup first"
  node -e '
    const fs = require("node:fs");
    const [file, host, port] = process.argv.slice(1);
    const identity = JSON.parse(fs.readFileSync(file, "utf8"));
    console.log(`Computer: ${identity.name}`);
    console.log(`Node ID:  ${identity.id}`);
    console.log(`URL:      http://${host}:${port}`);
    console.log(`Token:    ${identity.token}`);
  ' "$identity_file" "${host:-127.0.0.1}" "${port:-4317}"
}

update_service() {
  require_command git
  git -C "$REPO_ROOT" pull --ff-only
  setup_service
}

rollback_service() {
  local releases_dir current_release previous_release temporary_link
  releases_dir="$CONFIG_DIR/releases"
  [[ -d "$releases_dir" ]] || die "no previous release is available"
  quarantine_inactive_rejected_releases ||
    die "could not quarantine inactive rejected releases; the current release was not changed"
  current_release="$(readlink -f "$releases_dir/current" 2>/dev/null || true)"
  previous_release="$(
    find "$releases_dir" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\0' |
      sort -z -nr |
      while IFS= read -r -d '' entry; do
        release="${entry#* }"
        release="$(readlink -f "$release")"
        if [[ "$release" != "$current_release" &&
          ! -e "$release/.promotion-failed" ]]; then
          printf '%s\n' "$release"
          break
        fi
      done
  )"
  [[ -n "$previous_release" ]] || die "no previous release is available"
  temporary_link="$releases_dir/.current-$$"
  ln -s "$previous_release" "$temporary_link"
  mv -Tf "$temporary_link" "$releases_dir/current"
  sync_release_paths directories "$releases_dir"
  systemctl --user restart "$SERVICE_NAME"
  quarantine_inactive_rejected_releases ||
    die "the previous release was activated, but inactive rejected releases could not be quarantined"
  printf 'Rolled back to %s\n' "$(basename "$previous_release")"
}

uninstall_service() {
  systemctl --user disable --now "$SERVICE_NAME" 2>/dev/null || true
  rm -f -- "$SERVICE_FILE"
  systemctl --user daemon-reload
  if [[ -L "$COMMAND_LINK" && "$(readlink -f "$COMMAND_LINK")" == "$REPO_ROOT/bin/agentic-remote" ]]; then
    rm -f -- "$COMMAND_LINK"
  fi
  printf 'Agentic Remote service removed. Data in %s was preserved.\n' "$HOME/.agentic-remote"
}

command="${1:-help}"
if (($# > 0)); then
  shift
fi

case "$command" in
  setup)
    setup_service "$@"
    ;;
  start | stop | restart)
    (($# == 0)) || die "$command does not accept options"
    systemctl --user "$command" "$SERVICE_NAME"
    ;;
  status)
    (($# == 0)) || die "status does not accept options"
    systemctl --user --no-pager --full status "$SERVICE_NAME"
    ;;
  logs)
    (($# == 0)) || die "logs does not accept options"
    exec journalctl --user --unit "$SERVICE_NAME" --follow
    ;;
  pair-info)
    (($# == 0)) || die "pair-info does not accept options"
    pair_info
    ;;
  update)
    (($# == 0)) || die "update does not accept options"
    update_service
    ;;
  rollback)
    (($# == 0)) || die "rollback does not accept options"
    rollback_service
    ;;
  uninstall)
    (($# == 0)) || die "uninstall does not accept options"
    uninstall_service
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    die "unknown command: $command"
    ;;
esac
