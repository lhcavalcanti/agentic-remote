#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly SERVICE_NAME="agentic-remote.service"
readonly SYSTEMD_DIR="$HOME/.config/systemd/user"
readonly SERVICE_FILE="$SYSTEMD_DIR/$SERVICE_NAME"
readonly CONFIG_DIR="$HOME/.config/agentic-remote"
readonly ENV_FILE="$CONFIG_DIR/environment"
readonly COMMAND_LINK="$HOME/.local/bin/agentic-remote"

usage() {
  cat <<'EOF'
Usage: agentic-remote <command> [options]

Commands:
  setup [--host ADDRESS] [--port PORT] [--role hub|node] [--name NAME]
      Install dependencies, build the app, install and start the user service.
  pair-info
      Print this node's URL, identity, and pairing token.
  start
      Start the service.
  stop
      Stop the service.
  restart
      Restart the service.
  status
      Show service status.
  logs
      Follow service logs.
  update
      Pull the current branch, install dependencies, build, and restart.
  rollback
      Activate the previous immutable release and restart the service.
  uninstall
      Stop and remove the service. Application data is preserved.
  help
      Show this help.
EOF
}

die() {
  printf 'agentic-remote: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

config_value() {
  local key="$1"
  if [[ ! -f "$ENV_FILE" ]]; then
    return
  fi
  sed -n "s/^${key}=//p" "$ENV_FILE" | tail -n 1
}

validate_host() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] ||
    die "host must be an IPv4 address or hostname"
}

validate_port() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "port must be a number"
  ((10#$1 >= 1 && 10#$1 <= 65535)) || die "port must be between 1 and 65535"
}

validate_role() {
  [[ "$1" == "hub" || "$1" == "node" ]] || die "role must be hub or node"
}

validate_name() {
  [[ -n "$1" && "$1" != *$'\r'* && "$1" != *$'\n'* ]] ||
    die "name must be a single non-empty line"
}

systemd_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

write_service() {
  local pnpm_bin node_bin copilot_bin runtime_path temporary
  [[ "$REPO_ROOT" != *[[:space:]]* ]] ||
    die "repository paths containing whitespace are not supported by systemd setup"
  pnpm_bin="$(command -v pnpm)"
  node_bin="$(command -v node)"
  copilot_bin="$(command -v copilot)"
  runtime_path="$(dirname "$node_bin"):$(dirname "$pnpm_bin"):$(dirname "$copilot_bin"):/usr/local/bin:/usr/bin:/bin"
  temporary="$(mktemp "$SYSTEMD_DIR/.agentic-remote.service.XXXXXX")"

  cat >"$temporary" <<EOF
[Unit]
Description=Agentic Remote
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$CONFIG_DIR/releases/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=$(systemd_quote "PATH=$runtime_path")
Environment=$(systemd_quote "COPILOT_BIN=$copilot_bin")
EnvironmentFile=-$ENV_FILE
ExecStart=$(systemd_quote "$pnpm_bin") --dir $CONFIG_DIR/releases/current start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
EOF

  install -m 0644 "$temporary" "$SERVICE_FILE"
  rm -f -- "$temporary"
}

publish_release() {
  local releases_dir release_id release_dir temporary_link
  releases_dir="$CONFIG_DIR/releases"
  release_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  release_dir="$releases_dir/$release_id"
  temporary_link="$releases_dir/.current-$$"

  mkdir -p "$release_dir"
  mkdir -p "$release_dir/dist"
  cp -a "$REPO_ROOT/dist/." "$release_dir/dist/"
  cp -a \
    "$REPO_ROOT/server" \
    "$REPO_ROOT/shared" \
    "$REPO_ROOT/package.json" \
    "$REPO_ROOT/tsconfig.json" \
    "$REPO_ROOT/tsconfig.server.json" \
    "$release_dir/"
  cp -a "$REPO_ROOT/node_modules" "$release_dir/node_modules"
  ln -s "$release_dir" "$temporary_link"
  mv -Tf "$temporary_link" "$releases_dir/current"

  # Keep the current release plus two rollback candidates.
  find "$releases_dir" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
    sort -nr |
    tail -n +4 |
    cut -d' ' -f2- |
    while IFS= read -r old_release; do
      rm -rf -- "$old_release"
    done
}

enable_linger() {
  local linger
  linger="$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)"
  if [[ "$linger" == "yes" ]]; then
    return
  fi
  if ! loginctl enable-linger "$USER" 2>/dev/null; then
    printf '%s\n' \
      "Warning: boot startup requires an administrator to run:" \
      "  sudo loginctl enable-linger $USER" >&2
  fi
}

setup_service() {
  local host="" port="" role="" name="" data_directory="" allowed_origins=""
  while (($# > 0)); do
    case "$1" in
      --host)
        (($# >= 2)) || die "--host requires a value"
        host="$2"
        shift 2
        ;;
      --port)
        (($# >= 2)) || die "--port requires a value"
        port="$2"
        shift 2
        ;;
      --role)
        (($# >= 2)) || die "--role requires a value"
        role="$2"
        shift 2
        ;;
      --name)
        (($# >= 2)) || die "--name requires a value"
        name="$2"
        shift 2
        ;;
      *)
        die "unknown setup option: $1"
        ;;
    esac
  done

  require_command node
  require_command pnpm
  require_command copilot
  require_command systemctl
  require_command loginctl

  host="${host:-$(config_value HOST)}"
  port="${port:-$(config_value PORT)}"
  role="${role:-$(config_value AGENTIC_REMOTE_ROLE)}"
  name="${name:-$(config_value AGENTIC_REMOTE_NODE_NAME)}"
  data_directory="$(config_value AGENTIC_REMOTE_DATA_DIR)"
  allowed_origins="${AGENTIC_REMOTE_ALLOWED_ORIGINS:-$(config_value AGENTIC_REMOTE_ALLOWED_ORIGINS)}"
  host="${host:-127.0.0.1}"
  port="${port:-4317}"
  role="${role:-hub}"
  name="${name:-$(hostname)}"
  validate_host "$host"
  validate_port "$port"
  validate_role "$role"
  validate_name "$name"

  printf 'Installing dependencies...\n'
  pnpm --dir "$REPO_ROOT" install --frozen-lockfile
  printf 'Building production app...\n'
  pnpm --dir "$REPO_ROOT" build

  mkdir -p "$SYSTEMD_DIR" "$CONFIG_DIR" "$(dirname "$COMMAND_LINK")"
  publish_release
  local environment_tmp
  environment_tmp="$(mktemp "$CONFIG_DIR/.environment.XXXXXX")"
  printf '%s\n' \
    "HOST=$host" \
    "PORT=$port" \
    "AGENTIC_REMOTE_ROLE=$role" \
    "AGENTIC_REMOTE_NODE_NAME=$name" \
    "AGENTIC_REMOTE_RELEASE_DIR=$CONFIG_DIR/releases/current/dist" >"$environment_tmp"
  if [[ -n "$data_directory" ]]; then
    printf 'AGENTIC_REMOTE_DATA_DIR=%s\n' "$data_directory" >>"$environment_tmp"
  fi
  if [[ -n "$allowed_origins" ]]; then
    printf 'AGENTIC_REMOTE_ALLOWED_ORIGINS=%s\n' "$allowed_origins" >>"$environment_tmp"
  fi
  install -m 0600 "$environment_tmp" "$ENV_FILE"
  rm -f -- "$environment_tmp"

  write_service
  ln -sfn "$REPO_ROOT/bin/agentic-remote" "$COMMAND_LINK"
  systemctl --user daemon-reload
  systemctl --user enable "$SERVICE_NAME"
  systemctl --user restart "$SERVICE_NAME"
  enable_linger

  if [[ "$role" == "hub" ]]; then
    printf 'Agentic Remote hub is running at http://%s:%s/\n' "$host" "$port"
  else
    printf 'Agentic Remote node is running at http://%s:%s/\n' "$host" "$port"
    printf 'Run agentic-remote pair-info to register it with a hub.\n'
  fi
}

pair_info() {
  require_command node
  local host port identity_file
  host="$(config_value HOST)"
  port="$(config_value PORT)"
  local data_directory
  data_directory="$(config_value AGENTIC_REMOTE_DATA_DIR)"
  identity_file="${data_directory:-$HOME/.agentic-remote}/node.json"
  [[ -f "$identity_file" ]] || die "node identity not found; run setup first"
  node -e '
    const fs = require("node:fs");
    const [file, host, port] = process.argv.slice(1);
    const identity = JSON.parse(fs.readFileSync(file, "utf8"));
    console.log(`Computer: ${identity.name}`);
    console.log(`Node ID:  ${identity.id}`);
    console.log(`URL:      http://${host}:${port}`);
    console.log(`Token:    ${identity.token}`);
  ' "$identity_file" "${host:-127.0.0.1}" "${port:-4317}"
}

update_service() {
  require_command git
  git -C "$REPO_ROOT" pull --ff-only
  setup_service
}

rollback_service() {
  local releases_dir current_release previous_release temporary_link
  releases_dir="$CONFIG_DIR/releases"
  [[ -d "$releases_dir" ]] || die "no previous release is available"
  current_release="$(readlink -f "$releases_dir/current" 2>/dev/null || true)"
  previous_release="$(
    find "$releases_dir" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
      sort -nr |
      cut -d' ' -f2- |
      while IFS= read -r release; do
        release="$(readlink -f "$release")"
        if [[ "$release" != "$current_release" ]]; then
          printf '%s\n' "$release"
          break
        fi
      done
  )"
  [[ -n "$previous_release" ]] || die "no previous release is available"
  temporary_link="$releases_dir/.current-$$"
  ln -s "$previous_release" "$temporary_link"
  mv -Tf "$temporary_link" "$releases_dir/current"
  systemctl --user restart "$SERVICE_NAME"
  printf 'Rolled back to %s\n' "$(basename "$previous_release")"
}

uninstall_service() {
  systemctl --user disable --now "$SERVICE_NAME" 2>/dev/null || true
  rm -f -- "$SERVICE_FILE"
  systemctl --user daemon-reload
  if [[ -L "$COMMAND_LINK" && "$(readlink -f "$COMMAND_LINK")" == "$REPO_ROOT/bin/agentic-remote" ]]; then
    rm -f -- "$COMMAND_LINK"
  fi
  printf 'Agentic Remote service removed. Data in %s was preserved.\n' "$HOME/.agentic-remote"
}

command="${1:-help}"
if (($# > 0)); then
  shift
fi

case "$command" in
  setup)
    setup_service "$@"
    ;;
  start | stop | restart)
    (($# == 0)) || die "$command does not accept options"
    systemctl --user "$command" "$SERVICE_NAME"
    ;;
  status)
    (($# == 0)) || die "status does not accept options"
    systemctl --user --no-pager --full status "$SERVICE_NAME"
    ;;
  logs)
    (($# == 0)) || die "logs does not accept options"
    exec journalctl --user --unit "$SERVICE_NAME" --follow
    ;;
  pair-info)
    (($# == 0)) || die "pair-info does not accept options"
    pair_info
    ;;
  update)
    (($# == 0)) || die "update does not accept options"
    update_service
    ;;
  rollback)
    (($# == 0)) || die "rollback does not accept options"
    rollback_service
    ;;
  uninstall)
    (($# == 0)) || die "uninstall does not accept options"
    uninstall_service
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    die "unknown command: $command"
    ;;
esac
