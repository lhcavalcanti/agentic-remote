#!/usr/bin/env bash

set -Eeuo pipefail

readonly USER_HOME_DEFAULT="${AGENTIC_REMOTE_MONITOR_HOME:-${HOME:-}}"
readonly PROFILE_FILE="${AGENTIC_REMOTE_MONITOR_PROFILE:-$USER_HOME_DEFAULT/.config/agentic-remote/promotion.env}"

profile_value() {
  local key="$1" default="$2" value
  value="${!key-}"
  if [[ -n "$value" ]]; then
    printf '%s' "$value"
    return
  fi
  if [[ -f "$PROFILE_FILE" ]]; then
    value="$(sed -n "s/^${key}=//p" "$PROFILE_FILE" | tail -n 1)"
    if [[ -n "$value" ]]; then
      printf '%s' "$value"
      return
    fi
  fi
  printf '%s' "$default"
}

readonly DEV_ROOT="$(profile_value AGENTIC_REMOTE_MONITOR_DEV_ROOT '')"
readonly PROD_ROOT="$(profile_value AGENTIC_REMOTE_MONITOR_PROD_ROOT '')"
readonly USER_HOME="$(profile_value AGENTIC_REMOTE_MONITOR_HOME "$USER_HOME_DEFAULT")"
readonly GH_CLI_CONFIG_DIR="$(profile_value AGENTIC_REMOTE_MONITOR_GH_CONFIG_DIR '')"
readonly STATE_DIR="$(profile_value AGENTIC_REMOTE_MONITOR_STATE_DIR "$USER_HOME/.local/state/agentic-remote-monitor")"
readonly STATE_FILE="$STATE_DIR/last-graduated-commit"
readonly STATE_RECORD="$STATE_DIR/promotion-state"
readonly PENDING_RECORD="$STATE_DIR/pending-promotion"
readonly LOCK_FILE="$STATE_DIR/lock"
readonly SERVICE_NAME="$(profile_value AGENTIC_REMOTE_MONITOR_SERVICE agentic-remote.service)"
readonly DATA_DIR="$(profile_value AGENTIC_REMOTE_DATA_DIR '')"
readonly ALLOWED_ROOTS="$(profile_value AGENTIC_REMOTE_ALLOWED_ROOTS '')"
readonly ALLOWED_ORIGINS="$(profile_value AGENTIC_REMOTE_ALLOWED_ORIGINS '')"
readonly RUNTIME_TOOLS="$(profile_value AGENTIC_REMOTE_RUNTIME_TOOLS "$USER_HOME/.local/share/agentic-remote-runtime-tools")"
readonly RELEASE_ROOT="$(profile_value AGENTIC_REMOTE_MONITOR_RELEASE_ROOT "$USER_HOME/.config/agentic-remote/releases")"
readonly HEALTH_URL="$(profile_value AGENTIC_REMOTE_MONITOR_HEALTH_URL '')"
readonly EXTERNAL_URL="$(profile_value AGENTIC_REMOTE_MONITOR_EXTERNAL_URL '')"
readonly EXTERNAL_STATUS="$(profile_value AGENTIC_REMOTE_MONITOR_EXTERNAL_STATUS '')"
readonly DOWNSTREAM_HOSTS="$(profile_value AGENTIC_REMOTE_MONITOR_DOWNSTREAM_HOSTS '')"
readonly DOWNSTREAM_ROOT="$(profile_value AGENTIC_REMOTE_MONITOR_DOWNSTREAM_ROOT '')"
readonly DOWNSTREAM_HEALTH_URL="$(profile_value AGENTIC_REMOTE_MONITOR_DOWNSTREAM_HEALTH_URL '')"
readonly DOWNSTREAM_SSH="$(profile_value AGENTIC_REMOTE_MONITOR_DOWNSTREAM_SSH 'ssh -o BatchMode=yes')"
# How long to wait for a restarted service to answer. A slow machine may need
# more; a constrained test or a fast one may want less.
readonly READY_ATTEMPTS="$(profile_value AGENTIC_REMOTE_MONITOR_READY_ATTEMPTS 30)"
readonly READY_INTERVAL="$(profile_value AGENTIC_REMOTE_MONITOR_READY_INTERVAL 2)"
readonly PRODUCTION_HOST="$(profile_value AGENTIC_REMOTE_MONITOR_HOST '')"
readonly PRODUCTION_PORT="$(profile_value AGENTIC_REMOTE_MONITOR_PORT '')"
readonly PRODUCTION_ROLE="$(profile_value AGENTIC_REMOTE_MONITOR_ROLE '')"
readonly PRODUCTION_NAME="$(profile_value AGENTIC_REMOTE_MONITOR_NAME '')"

if [[ -n "$GH_CLI_CONFIG_DIR" ]]; then
  # A private HTTPS remote authenticates through `gh auth git-credential`,
  # which reads its configuration from here. Without it the monitor cannot
  # pull, and a machine whose profile names this directory would find the
  # setting quietly ignored. This is Git authentication only: it neither
  # enables nor requires hosted CI.
  export GH_CONFIG_DIR="$GH_CLI_CONFIG_DIR"
fi

log() {
  printf '[agentic-remote-promotion] %s\n' "$*"
}

die() {
  log "ERROR: $*"
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_value() {
  local name="$1" value="$2"
  [[ -n "$value" ]] || die "$name is required in $PROFILE_FILE"
}

assert_repository() {
  local root="$1"
  git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1 ||
    die "not a Git repository: $root"
}

assert_clean() {
  local root="$1" changes
  # Assigned first so that a git that failed fails the check. Testing the
  # output on its own read an unreadable or corrupt worktree as a clean one,
  # and this gate is what says the commit that was tested is the commit being
  # promoted.
  changes="$(git -C "$root" status --porcelain)" ||
    die "worktree could not be read: $root"
  [[ -z "$changes" ]] ||
    die "worktree is not clean: $root"
}

sync_promotion_state() {
  python3 - "$STATE_DIR" <<'PY'
import os
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
}

read_current_release() {
  if [[ ! -e "$RELEASE_ROOT/current" && ! -L "$RELEASE_ROOT/current" ]]; then
    return 0
  fi
  readlink -f -- "$RELEASE_ROOT/current"
}

sync_release_inventory() {
  python3 - "$RELEASE_ROOT" <<'PY'
import os
import sys

root = os.path.realpath(sys.argv[1])
for directory in (root, root + ".rejected"):
    if not os.path.lexists(directory):
        continue
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
PY
}

mark_pending_candidate_failed() {
  python3 - "$PENDING_RELEASE" "$PENDING_COMMIT" <<'PY'
import os
import sys

release, commit = sys.argv[1:]
fd = os.open(os.path.join(release, ".promotion-failed"),
             os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as stream:
    stream.write(commit + "\n")
    stream.flush()
    os.fsync(stream.fileno())
fd = os.open(release, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
}

write_pending_promotion() {
  local phase="$1" candidate_commit="$2" previous_commit="$3"
  local candidate_release="$4" previous_release="$5"
  local temporary="$STATE_DIR/.pending-promotion-$phase-$$-$RANDOM"
  python3 - "$temporary" "$PENDING_RECORD" "$phase" "$candidate_commit" \
    "$previous_commit" "$candidate_release" "$previous_release" "$PROD_ROOT" "$RELEASE_ROOT" <<'PY' || return 1
import json
import os
import sys

temporary, pending, phase, candidate, previous, release, previous_release, runtime, root = sys.argv[1:]
record = {
    "version": 1,
    "phase": phase,
    "candidate_commit": candidate,
    "previous_commit": previous,
    "candidate_release": release,
    "previous_release": previous_release,
    "runtime_root": os.path.realpath(runtime),
    "release_root": os.path.realpath(root),
}
if phase == "prepared":
    if os.path.lexists(pending) or os.path.lexists(release):
        raise SystemExit("A pending promotion or candidate release already exists")
else:
    if os.path.islink(pending):
        raise SystemExit("The pending promotion was replaced by a symlink")
    with open(pending, encoding="utf-8") as stream:
        existing = json.load(stream)
    expected_phase = {"local-verified": "prepared", "verified": "local-verified"}[phase]
    if existing != {**record, "phase": expected_phase}:
        raise SystemExit("The pending promotion changed before its checkpoint")
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as stream:
    json.dump(record, stream)
    stream.write("\n")
    stream.flush()
    os.fsync(stream.fileno())
PY
  mv -Tf -- "$temporary" "$PENDING_RECORD" || return 1
  sync_promotion_state
}

load_pending_promotion() {
  local parsed
  local -a fields
  parsed="$(python3 - "$PENDING_RECORD" "$PROD_ROOT" "$RELEASE_ROOT" <<'PY'
import json
import os
import re
import stat
import sys

pending, runtime, root = sys.argv[1:]
if not stat.S_ISREG(os.lstat(pending).st_mode):
    raise SystemExit("Pending promotion is not a regular file")
with open(pending, encoding="utf-8") as stream:
    record = json.load(stream)
keys = {
    "version", "phase", "candidate_commit", "previous_commit",
    "candidate_release", "previous_release", "runtime_root", "release_root",
}
if not isinstance(record, dict) or set(record) != keys or type(record["version"]) is not int or record["version"] != 1:
    raise SystemExit("Unsupported pending promotion record")
for key in keys - {"version"}:
    value = record[key]
    if not isinstance(value, str) or any(c in value for c in "\0\r\n") or (not value and key != "previous_release"):
        raise SystemExit("Invalid pending promotion value: " + key)
if record["phase"] not in ("prepared", "local-verified", "verified"):
    raise SystemExit("Invalid pending promotion phase")
for key in ("candidate_commit", "previous_commit"):
    if not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", record[key]):
        raise SystemExit("Invalid pending promotion commit")
root = os.path.realpath(root)
if record["runtime_root"] != os.path.realpath(runtime) or record["release_root"] != root:
    raise SystemExit("Pending promotion belongs to another runtime or release root")
for key in ("candidate_release", "previous_release"):
    value = record[key]
    if not value and key == "previous_release":
        continue
    if (os.path.dirname(value) != root or os.path.realpath(value) != value or
        not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", os.path.basename(value))):
        raise SystemExit("Invalid pending promotion release path: " + key)
if record["candidate_release"] == record["previous_release"]:
    raise SystemExit("Pending candidate cannot be its own rollback baseline")
for key in ("phase", "candidate_commit", "previous_commit", "candidate_release", "previous_release"):
    print(record[key])
PY
)" || die "could not read the pending promotion; no runtime changes were made"
  mapfile -t fields <<<"$parsed"
  PENDING_PHASE="${fields[0]}"
  PENDING_COMMIT="${fields[1]}"
  PENDING_PREVIOUS_COMMIT="${fields[2]}"
  PENDING_RELEASE="${fields[3]}"
  PENDING_PREVIOUS_RELEASE="${fields[4]:-}"
  git -C "$PROD_ROOT" cat-file -e "$PENDING_COMMIT^{commit}" &&
    git -C "$PROD_ROOT" cat-file -e "$PENDING_PREVIOUS_COMMIT^{commit}" ||
    die "a pending promotion commit is unavailable"
}

pending_record_committed() {
  [[ -f "$STATE_RECORD" && ! -L "$STATE_RECORD" ]] &&
    grep -Fxq -- "candidate_commit=$PENDING_COMMIT" "$STATE_RECORD" &&
    grep -Fxq -- "tested_commit=$PENDING_COMMIT" "$STATE_RECORD" &&
    grep -Fxq -- "promoted_commit=$PENDING_COMMIT" "$STATE_RECORD" &&
    grep -Fxq -- "previous_runtime_commit=$PENDING_PREVIOUS_COMMIT" "$STATE_RECORD" &&
    grep -Fxq -- "promoted_release=$PENDING_RELEASE" "$STATE_RECORD" &&
    grep -Fxq -- "previous_release=$PENDING_PREVIOUS_RELEASE" "$STATE_RECORD"
}

clear_pending_promotion() {
  rm -- "$PENDING_RECORD" || return 1
  sync_promotion_state
}

complete_pending_promotion() {
  local temporary_record="$STATE_RECORD.$$-$RANDOM"
  local temporary_state="$STATE_FILE.$$-$RANDOM"
  if ! pending_record_committed; then
    [[ ! -L "$STATE_RECORD" ]] || die "the promotion state record is a symlink"
    python3 - "$temporary_record" "$PENDING_COMMIT" "$PENDING_PREVIOUS_COMMIT" \
      "$PENDING_RELEASE" "$PENDING_PREVIOUS_RELEASE" <<'PY' || die "could not prepare the promotion state; the pending promotion was retained"
import datetime
import os
import sys

temporary, commit, previous_commit, release, previous_release = sys.argv[1:]
values = {
    "candidate_commit": commit, "tested_commit": commit, "promoted_commit": commit,
    "previous_runtime_commit": previous_commit, "promoted_release": release,
    "previous_release": previous_release,
    "promoted_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as stream:
    for key, value in values.items():
        stream.write(f"{key}={value}\n")
    stream.flush()
    os.fsync(stream.fileno())
PY
    mv -Tf -- "$temporary_record" "$STATE_RECORD" && sync_promotion_state ||
      die "could not commit the promotion state; the pending promotion was retained"
  fi
  if [[ ! -f "$STATE_FILE" || "$(cat -- "$STATE_FILE")" != "$PENDING_COMMIT" ]]; then
    [[ ! -L "$STATE_FILE" ]] || die "the success marker is a symlink"
    python3 - "$temporary_state" "$PENDING_COMMIT" <<'PY' || die "could not prepare the success marker; the pending promotion was retained"
import os
import sys

fd = os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as stream:
    stream.write(sys.argv[2] + "\n")
    stream.flush()
    os.fsync(stream.fileno())
PY
    mv -Tf -- "$temporary_state" "$STATE_FILE" && sync_promotion_state ||
      die "could not commit the success marker; the pending promotion was retained"
  fi
  clear_pending_promotion ||
    die "promotion was recorded but its pending journal could not be cleared"
  log "graduated $PENDING_COMMIT successfully"
}

rollback_runtime() {
  local restore_commit="$1" restore_release="$2" link attempt
  log "rolling back the production runtime to $restore_commit"
  if [[ -n "$restore_release" && -d "$restore_release" &&
    ! -e "$restore_release/.promotion-failed" ]]; then
    link="$RELEASE_ROOT/.current-rollback-$$"
    if rm -f -- "$link" &&
      ln -s "$restore_release" "$link" &&
      mv -Tf "$link" "$RELEASE_ROOT/current" &&
      [[ "$(readlink -f -- "$RELEASE_ROOT/current")" == "$restore_release" ]]; then
      log "restored release $(basename "$restore_release")"
    else
      rm -f -- "$link" || true
      log "WARNING: could not restore the previous release pointer"
      return 1
    fi
  else
    log "WARNING: no previous healthy release to restore"
    return 1
  fi
  if ! systemctl --user restart "$SERVICE_NAME"; then
    log "WARNING: could not restart $SERVICE_NAME"
    return 1
  fi
  for attempt in $(seq 1 "$READY_ATTEMPTS"); do
    if systemctl --user is-active --quiet "$SERVICE_NAME" &&
      curl -fsS --max-time 5 "$HEALTH_URL" >/dev/null; then
      return 0
    fi
    sleep "$READY_INTERVAL"
  done
  log "WARNING: the restored runtime did not pass its health check"
  return 1
}

remove_failed_release() {
  local failed_release="$1" restore_release="$2"
  # Recheck both paths after restarting: never remove a release that is still
  # current, or a replacement symlink that no longer names the failed candidate.
  if [[ "$failed_release" != "$restore_release" &&
    -d "$restore_release" &&
    "$(readlink -f -- "$RELEASE_ROOT/current")" == "$restore_release" &&
    -d "$failed_release" && ! -L "$failed_release" &&
    "$(readlink -f -- "$failed_release")" == "$failed_release" ]] &&
    rm -rf -- "$failed_release"; then
    log "removed rejected release $(basename "$failed_release")"
    return 0
  fi
  log "WARNING: could not safely remove rejected release $failed_release"
  return 1
}

quarantine_failed_release() {
  local failed_release="$1" restore_release="$2" quarantine_root target
  [[ "$failed_release" != "$restore_release" &&
    "$(readlink -f -- "$RELEASE_ROOT/current")" == "$restore_release" &&
    -d "$failed_release" && ! -L "$failed_release" &&
    "$(readlink -f -- "$failed_release")" == "$failed_release" ]] || return 1
  quarantine_root="$(resolve_path "$RELEASE_ROOT").rejected"
  [[ ! -L "$quarantine_root" ]] || return 1
  mkdir -p -- "$quarantine_root" || return 1
  target="$quarantine_root/$(basename -- "$failed_release")"
  [[ ! -e "$target" && ! -L "$target" ]] || return 1
  python3 -c 'import os, sys; os.rename(sys.argv[1], sys.argv[2])' \
    "$failed_release" "$target" || return 1
  sync_release_inventory || return 1
  log "quarantined rejected release at $target"
}

verify_local_promotion() {
  local commit="$1" release="$2" installed_commit installed_branch installed_changes
  local attempt healthy=0 external_status
  if ! installed_commit="$(git -C "$PROD_ROOT" rev-parse HEAD)" ||
    ! installed_branch="$(git -C "$PROD_ROOT" branch --show-current)" ||
    ! installed_changes="$(git -C "$PROD_ROOT" status --porcelain)"; then
    printf '%s' "production runtime source could not be read after setup"
    return 1
  fi
  if [[ "$installed_commit" != "$commit" || -n "$installed_branch" || -n "$installed_changes" ]]; then
    printf '%s' "production runtime source changed during setup"
    return 1
  fi
  for attempt in $(seq 1 "$READY_ATTEMPTS"); do
    if systemctl --user is-active --quiet "$SERVICE_NAME" &&
      curl -fsS --max-time 5 "$HEALTH_URL" >/dev/null; then
      healthy=1
      break
    fi
    sleep "$READY_INTERVAL"
  done
  if [[ "$healthy" != 1 ]]; then
    printf '%s' "production runtime health check failed after graduation"
    return 1
  fi
  if [[ ! -L "$RELEASE_ROOT/current" ||
    "$(readlink -f -- "$RELEASE_ROOT/current")" != "$release" ]]; then
    printf '%s' "production release pointer does not identify this candidate"
    return 1
  fi
  if [[ -n "$EXTERNAL_URL" ]]; then
    if ! external_status="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$EXTERNAL_URL")"; then
      printf '%s' "external access check failed: $EXTERNAL_URL"
      return 1
    fi
    if [[ -n "$EXTERNAL_STATUS" && "$external_status" != "$EXTERNAL_STATUS" ]]; then
      printf '%s' "external access returned HTTP $external_status; expected $EXTERNAL_STATUS"
      return 1
    fi
    if [[ -z "$EXTERNAL_STATUS" && ! "$external_status" =~ ^[23][0-9][0-9]$ ]]; then
      printf '%s' "external access returned unexpected HTTP $external_status"
      return 1
    fi
  fi
}

recover_pending_promotion() {
  local mode="${1:-interrupted}" current_release failed_release="" runtime_restored=0 failure source_commit
  load_pending_promotion
  source_commit="$(git -C "$PROD_ROOT" rev-parse HEAD)"
  [[ "$source_commit" == "$PENDING_COMMIT" || "$source_commit" == "$PENDING_PREVIOUS_COMMIT" ]] ||
    die "the runtime source changed outside the pending promotion; it and the journal were preserved"
  log "reconciling $PENDING_PHASE promotion of $PENDING_COMMIT"
  if pending_record_committed || [[ "$PENDING_PHASE" == verified ]]; then
    [[ ! -e "$PENDING_RELEASE/.promotion-failed" &&
      ! -e "$(resolve_path "$RELEASE_ROOT").rejected/$(basename -- "$PENDING_RELEASE")/.promotion-failed" ]] ||
      die "the verified pending candidate was subsequently rejected; the journal was retained"
    complete_pending_promotion
    return
  fi
  current_release="$(read_current_release)" || die "could not resolve the current release"
  if [[ "$PENDING_PHASE" == local-verified &&
    "$current_release" == "$PENDING_RELEASE" &&
    ! -e "$PENDING_RELEASE/.promotion-failed" ]]; then
    if failure="$(verify_local_promotion "$PENDING_COMMIT" "$PENDING_RELEASE")"; then
      promote_downstream "$PENDING_COMMIT" ||
        die "downstream promotion failed; the pending promotion and success marker were left unchanged"
      write_pending_promotion verified "$PENDING_COMMIT" "$PENDING_PREVIOUS_COMMIT" \
        "$PENDING_RELEASE" "$PENDING_PREVIOUS_RELEASE" ||
        die "could not record completed verification; the pending promotion was retained"
      load_pending_promotion
      complete_pending_promotion
      return
    fi
    log "ERROR: $failure"
  fi
  if [[ -d "$PENDING_RELEASE" && ! -L "$PENDING_RELEASE" ]]; then
    failed_release="$PENDING_RELEASE"
    mark_pending_candidate_failed ||
      die "could not mark the pending candidate as rejected; its journal was retained"
  fi
  # A manual action may have selected another healthy release. Do not replace
  # that choice with either endpoint of an interrupted transaction.
  if [[ "$current_release" != "$PENDING_RELEASE" &&
    "$current_release" != "$PENDING_PREVIOUS_RELEASE" ]]; then
    if [[ -n "$failed_release" && -d "$current_release" &&
      ! -e "$current_release/.promotion-failed" ]]; then
      quarantine_failed_release "$failed_release" "$current_release" ||
        die "the current release changed and the pending candidate could not be quarantined"
    fi
    die "the current release changed outside the pending promotion; it was preserved and the journal needs reconciliation"
  fi
  if [[ -z "$PENDING_PREVIOUS_RELEASE" && -z "$current_release" && -z "$failed_release" ]]; then
    git -C "$PROD_ROOT" switch --detach "$PENDING_PREVIOUS_COMMIT" ||
      die "could not restore the production runtime source; the pending journal was retained"
    clear_pending_promotion || die "could not clear the unactivated pending promotion"
    die "graduation failed before publication; the previous runtime source was restored"
  fi
  if rollback_runtime "$PENDING_PREVIOUS_COMMIT" "$PENDING_PREVIOUS_RELEASE"; then
    runtime_restored=1
    if [[ -n "$failed_release" ]]; then
      if [[ "$mode" == interrupted ]] ||
        ! remove_failed_release "$failed_release" "$PENDING_PREVIOUS_RELEASE"; then
        quarantine_failed_release "$failed_release" "$PENDING_PREVIOUS_RELEASE" ||
          die "graduation failed; the previous release was restored but the rejected release was retained; the runtime source was not restored"
      fi
    fi
  elif [[ -n "$failed_release" ]] &&
    [[ "$(readlink -f -- "$RELEASE_ROOT/current")" == "$PENDING_PREVIOUS_RELEASE" ]]; then
    quarantine_failed_release "$failed_release" "$PENDING_PREVIOUS_RELEASE" ||
      die "graduation failed; could not quarantine the inactive rejected release; the runtime source was not restored"
  fi
  # The installed CLI follows PROD_ROOT. Only downgrade it after the rejected
  # candidate is no longer eligible for even a legacy rollback implementation.
  if [[ -n "$PENDING_PREVIOUS_RELEASE" &&
    "$(readlink -f -- "$RELEASE_ROOT/current")" == "$PENDING_PREVIOUS_RELEASE" ]]; then
    sync_release_inventory ||
      die "could not durably exclude the rejected candidate; the runtime source and pending journal were retained"
    git -C "$PROD_ROOT" switch --detach "$PENDING_PREVIOUS_COMMIT" ||
      die "graduation failed; could not restore the production runtime source to $PENDING_PREVIOUS_COMMIT"
    assert_clean "$PROD_ROOT"
    if [[ "$runtime_restored" == 1 ]]; then
      clear_pending_promotion ||
        die "the previous runtime was restored but the pending journal could not be cleared"
      die "graduation failed and the previous runtime was restored"
    fi
  fi
  die "graduation failed; could not fully restore the previous runtime; the rejected release and pending journal were retained"
}

# Second promotion phase. Values reach a remote bash through printf %q so a
# path or URL containing spaces, quotes, or substitutions is data rather than
# code.
run_remote() {
  local host="$1" script="$2"
  $DOWNSTREAM_SSH "$host" "bash -lc $(printf '%q' "$script")"
}

# Rebuild an exact known-good commit rather than reactivating whatever release
# happens to be newest, so recovery does not depend on directory timestamps.
restore_downstream() {
  local host="$1" commit="$2" root_q commit_q
  root_q="$(printf '%q' "$DOWNSTREAM_ROOT")"
  commit_q="$(printf '%q' "$commit")"
  log "restoring $host to $commit"
  run_remote "$host" \
    "cd $root_q && git checkout --detach $commit_q && ./bin/agentic-remote setup" ||
    log "WARNING: could not restore $host to $commit"
}

# The local runtime has already proven this commit, so each host installs that
# exact commit. Using the branch tip instead would build and activate whatever
# main points at now, which is not what was validated.
promote_downstream() {
  local commit="$1" host root_q commit_q url_q status head attempt healthy
  local -a promoted=()
  [[ -n "$DOWNSTREAM_HOSTS" ]] || return 0

  root_q="$(printf '%q' "$DOWNSTREAM_ROOT")"
  commit_q="$(printf '%q' "$commit")"

  for host in $DOWNSTREAM_HOSTS; do
    log "promoting $commit to $host"

    # Capture the commit to return to before anything is mutated.
    if ! status="$(run_remote "$host" "cd $root_q && git rev-parse HEAD")" ||
      [[ -z "$status" ]]; then
      # An empty answer would later restore the host to an empty revision.
      log "ERROR: cannot read the checkout on $host: $DOWNSTREAM_ROOT"
      restore_promoted "$commit" "${promoted[@]+"${promoted[@]}"}"
      return 1
    fi
    local previous_head="$status"

    # Assigning first makes a failing git fail the check; testing its output
    # directly would treat a git error as a clean worktree.
    if ! run_remote "$host" \
      "cd $root_q && changes=\$(git status --porcelain) && test -z \"\$changes\""; then
      log "ERROR: $host checkout is dirty or unreadable: $DOWNSTREAM_ROOT"
      restore_promoted "$commit" "${promoted[@]+"${promoted[@]}"}"
      return 1
    fi

    if ! run_remote "$host" \
      "cd $root_q && git fetch --prune origin && git checkout --detach $commit_q && ./bin/agentic-remote setup"; then
      log "ERROR: install failed on $host"
      restore_downstream "$host" "$previous_head"
      restore_promoted "$commit" "${promoted[@]+"${promoted[@]}"}"
      return 1
    fi

    head="$(run_remote "$host" "cd $root_q && git rev-parse HEAD")" || head=""
    if [[ "$head" != "$commit" ]]; then
      log "ERROR: $host is at ${head:-unknown}, not the validated $commit"
      restore_downstream "$host" "$previous_head"
      restore_promoted "$commit" "${promoted[@]+"${promoted[@]}"}"
      return 1
    fi

    if [[ -n "$DOWNSTREAM_HEALTH_URL" ]]; then
      url_q="$(printf '%q' "$DOWNSTREAM_HEALTH_URL")"
      healthy=0
      # Match the local readiness wait; a single probe races the restart.
      for attempt in $(seq 1 "$READY_ATTEMPTS"); do
        if run_remote "$host" "curl -fsS --max-time 5 $url_q >/dev/null"; then
          healthy=1
          break
        fi
        sleep "$READY_INTERVAL"
      done
      if [[ "$healthy" != 1 ]]; then
        log "ERROR: health check failed on $host"
        restore_downstream "$host" "$previous_head"
        restore_promoted "$commit" "${promoted[@]+"${promoted[@]}"}"
        return 1
      fi
    fi

    promoted+=("$host:$previous_head")
    log "promoted $commit to $host"
  done
}

# Return hosts already promoted in this run so a partial failure does not leave
# the fleet split across two commits.
restore_promoted() {
  shift
  local entry host previous
  for entry in "$@"; do
    host="${entry%%:*}"
    previous="${entry##*:}"
    restore_downstream "$host" "$previous"
  done
}

package_manager_version() {
  python3 - "$1/package.json" <<'PY'
import json
import sys

package_manager = json.load(open(sys.argv[1], encoding="utf-8"))["packageManager"]
name, version = package_manager.split("@", 1)
if name != "pnpm" or not version:
    raise SystemExit(f"Unsupported packageManager: {package_manager}")
print(version)
PY
}

resolve_path() {
  readlink -f -- "$1" 2>/dev/null || printf '%s' "$1"
}

# Tidies a path by text alone, without asking the filesystem about it.
#
# `readlink -f` gives up and prints nothing once a directory in the middle of
# the path has gone -- which is exactly the state cleanup is called on: the
# validation directory removed, its record left behind pointing at where it
# used to be. Comparing against nothing matched nothing, so the record was
# never taken away and every later `worktree add` at that path failed.
# Canonicalises as much of the path as exists, and tidies the rest by text.
#
# Git records the real path, so a state directory reached through a symlink is
# written down canonically while this was still spelling it the way the profile
# does -- and the two never matched, leaving the monitor unable to find its own
# record. The deepest part that exists is asked of the filesystem; whatever is
# missing below it, which is the case this is needed for, is appended.
canonical_path() {
  local path="$1" head tail_part=""
  [[ "$path" == /* ]] || path="$PWD/$path"
  head="$(normalize_path "$path")"
  while [[ "$head" != / && ! -e "$head" ]]; do
    tail_part="${head##*/}${tail_part:+/$tail_part}"
    head="${head%/*}"
    [[ -n "$head" ]] || head=/
  done
  local resolved
  resolved="$(readlink -f -- "$head" 2>/dev/null || printf '%s' "$head")"
  [[ -n "$resolved" ]] || resolved="$head"
  if [[ -z "$tail_part" ]]; then
    printf '%s' "$resolved"
  elif [[ "$resolved" == / ]]; then
    printf '/%s' "$tail_part"
  else
    printf '%s/%s' "$resolved" "$tail_part"
  fi
}

normalize_path() {
  local path="$1" part
  local -a parts=() kept=()
  [[ "$path" == /* ]] || path="$PWD/$path"
  IFS='/' read -r -a parts <<<"$path"
  for part in "${parts[@]}"; do
    case "$part" in
      '' | '.') ;;
      '..')
        [[ ${#kept[@]} -eq 0 ]] || unset 'kept[${#kept[@]}-1]'
        ;;
      *) kept+=("$part") ;;
    esac
  done
  printf '/%s' "${kept[@]+${kept[@]}}" | sed 's|^//*$|/|'
}

# Refuses a path that is, or contains, something the monitor is responsible
# for. Cleanup removes this directory outright, so naming a checkout here
# would delete it.
# The signature git carries for a worktree this monitor made. Written as the
# lock reason by `worktree add --lock`, so it exists from the moment the
# worktree does rather than a moment later.
VALIDATE_LOCK_SIGNATURE='agentic-remote promotion monitor validation worktree'

# This repository's shared git directory, where the record of every linked
# worktree is kept. Asked of git rather than assumed: a development root that
# is itself a linked worktree, or uses a separate git directory, keeps those
# records somewhere other than `$DEV_ROOT/.git`.
validate_common_dir() {
  local common
  common="$(git -C "$DEV_ROOT" rev-parse --git-common-dir 2>/dev/null || true)"
  [[ -n "$common" ]] || return 1
  case "$common" in
    /*) ;;
    *) common="$DEV_ROOT/$common" ;;
  esac
  resolve_path "$common"
}

# The record git keeps for the worktree at $VALIDATE_ROOT, or nothing.
#
# Found by reading the records rather than by asking the worktree, because the
# answer is still needed when the worktree is gone from disk and only its
# record remains -- which is the case that blocks the next `worktree add`.
# Each record's `gitdir` file names the `.git` file of the worktree it belongs
# to, and may legally be relative when `worktree.useRelativePaths` is set, so
# it is resolved from the record's own directory.
validate_worktree_record() {
  local common record pointer target
  common="$(validate_common_dir)" || return 1
  target="$(canonical_path "$VALIDATE_ROOT")/.git"
  for record in "$common"/worktrees/*; do
    [[ -d "$record" ]] || continue
    pointer="$(cat -- "$record/gitdir" 2>/dev/null || true)"
    [[ -n "$pointer" ]] || continue
    case "$pointer" in
      /*) ;;
      *) pointer="$record/$pointer" ;;
    esac
    # Tidied by text, because the worktree this points at may already be gone
    # -- which is the very case this record has to be found for.
    [[ "$(canonical_path "$pointer")" == "$target" ]] || continue
    printf '%s' "$record"
    return 0
  done
  return 1
}

# Whether the validation worktree is this monitor's to remove.
#
# Two things have to agree. Git's own record for the path has to carry this
# monitor's lock reason, which nothing but `worktree add --lock` here writes,
# and which is in place from the moment the worktree is registered -- so a run
# killed straight after creating one still leaves something later runs can
# recognise and clear away. And the marker has to name the same run, which is
# what tells this run's worktree from one another run of the monitor is using
# at the same path.
#
# Cleanliness is deliberately not required. Validation installs and builds in
# there, so the monitor's own worktree is expected to be untidy; ownership is
# what decides, and refusing on tidiness left the monitor unable to clear its
# own scratch space.
validation_worktree_removable() {
  local record reason token resolved pointer
  record="$(validate_worktree_record)" || return 1
  # The record points at this path; this path has to point back at the record.
  # Matching one way only means a record left behind by an interrupted run can
  # vouch for whatever is at the path now -- a checkout somebody put there
  # since, which cleanup would then delete.
  if [[ -e "$VALIDATE_ROOT" ]]; then
    if [[ -e "$VALIDATE_ROOT/.git" ]]; then
      # A repository of its own keeps `.git` as a directory rather than the
      # file a linked worktree leaves, and either way its presence says this is
      # somebody's checkout and not the remains of one of ours.
      [[ -f "$VALIDATE_ROOT/.git" ]] || return 1
      pointer="$(sed -n 's/^gitdir: *//p' "$VALIDATE_ROOT/.git" 2>/dev/null || true)"
      [[ -n "$pointer" ]] || return 1
      case "$pointer" in
        /*) ;;
        *) pointer="$VALIDATE_ROOT/$pointer" ;;
      esac
      [[ "$(resolve_path "$pointer")" == "$(resolve_path "$record")" ]] || return 1
    else
      # Nothing named `.git` at all, on a path that still holds something. `worktree
      # remove` takes the pointer away before it has finished deleting, so a
      # run killed inside that window leaves exactly this. Only a removal this
      # monitor had already begun and recorded is recognised, and a checkout
      # somebody else puts here has a pointer of its own, so it never reaches
      # this branch.
      [[ -n "${VALIDATE_MARKER:-}" && -f "$VALIDATE_MARKER" ]] || return 1
      [[ "$(sed -n '3p' -- "$VALIDATE_MARKER" 2>/dev/null)" == removing ]] ||
        return 1
    fi
  fi
  reason="$(cat -- "$record/locked" 2>/dev/null || true)"
  [[ "$reason" == "$VALIDATE_LOCK_SIGNATURE "* ]] || return 1
  if [[ -n "${VALIDATE_MARKER:-}" && -f "$VALIDATE_MARKER" ]]; then
    resolved="$(resolve_path "$VALIDATE_ROOT")"
    [[ "$(sed -n '1p' -- "$VALIDATE_MARKER" 2>/dev/null)" == "$resolved" ]] || return 1
    token="$(sed -n '2p' -- "$VALIDATE_MARKER" 2>/dev/null)"
    [[ -n "$token" ]] || return 1
    [[ "$reason" == "$VALIDATE_LOCK_SIGNATURE $token" ]] || return 1
  fi
  return 0
}

# Takes git's record of the validation worktree away, and nothing else.
#
# A record whose worktree is missing keeps every later `worktree add` at that
# path failing, and git keeps such a record for three months by default.
# `worktree prune` would clear it, but prunes the whole repository: any
# unrelated worktree that happened to be unreachable at that moment -- an
# unmounted drive, a detached one holding the only reference to its commits --
# would lose its record too. Only the one record known to be the monitor's is
# removed, which is all git's own prune does to it.
deregister_validation_worktree() {
  local record
  record="$(validate_worktree_record)" || return 0
  [[ "$(cat -- "$record/locked" 2>/dev/null || true)" == "$VALIDATE_LOCK_SIGNATURE "* ]] ||
    return 0
  rm -rf -- "$record"
}

cleanup_validation_worktree() {
  # The trap fires however the run ended, including before any of this was set.
  [[ -n "${VALIDATE_ROOT:-}" ]] || return 0
  if [[ ! -e "$VALIDATE_ROOT" ]]; then
    rm -f -- "${VALIDATE_MARKER:-}"
    deregister_validation_worktree
    return 0
  fi
  # An empty directory holds nothing to lose, and a previous run can leave one
  # behind. Refusing it would wedge every run that followed.
  if [[ -d "$VALIDATE_ROOT" && ! -L "$VALIDATE_ROOT" ]] &&
    [[ -z "$(ls -A -- "$VALIDATE_ROOT" 2>/dev/null)" ]]; then
    rmdir -- "$VALIDATE_ROOT" 2>/dev/null || true
    rm -f -- "${VALIDATE_MARKER:-}"
    deregister_validation_worktree
    return 0
  fi
  if ! validation_worktree_removable; then
    die "refusing to remove $VALIDATE_ROOT: it is not a validation worktree this monitor created"
  fi
  # Written down before the removal starts, because the removal takes the
  # worktree's own pointer away partway through and that pointer is what
  # ownership is read from while the directory still exists. Without this, a
  # run killed mid-deletion left a directory no later run would agree to
  # finish.
  if [[ -n "${VALIDATE_MARKER:-}" && -f "$VALIDATE_MARKER" ]]; then
    printf 'removing\n' >>"$VALIDATE_MARKER"
  fi
  # `--force` twice is how git removes a worktree that is locked. Unlocking
  # first would have thrown away the very thing that says the worktree is this
  # monitor's, and an interruption in that gap left one no later run would
  # touch.
  git -C "$DEV_ROOT" worktree remove --force --force "$VALIDATE_ROOT" 2>/dev/null ||
    true
  if [[ -e "$VALIDATE_ROOT" ]]; then
    rm -rf -- "$VALIDATE_ROOT"
  fi
  rm -f -- "$VALIDATE_MARKER"
  # `worktree remove` normally takes the record with it. This covers the case
  # where it declined and the directory was removed here instead.
  deregister_validation_worktree
}

assert_disposable() {
  local target resolved protected other
  target="$1"
  resolved="$(resolve_path "$target")"
  [[ -n "$resolved" && "$resolved" != "/" ]] ||
    die "validation worktree path is not usable: $target"
  for protected in "$DEV_ROOT" "$PROD_ROOT" "$RELEASE_ROOT" "$USER_HOME"; do
    [[ -n "$protected" ]] || continue
    other="$(resolve_path "$protected")"
    [[ "$resolved" != "$other" ]] ||
      die "validation worktree would be $protected"
    [[ "$other" != "$resolved"/* ]] ||
      die "validation worktree would contain $protected"
  done
}

run_pnpm() {
  local root="$1"
  shift
  corepack "pnpm@$(package_manager_version "$root")" --dir "$root" "$@"
}

run() {
  require_value AGENTIC_REMOTE_MONITOR_DEV_ROOT "$DEV_ROOT"
  require_value AGENTIC_REMOTE_MONITOR_PROD_ROOT "$PROD_ROOT"
  require_value AGENTIC_REMOTE_MONITOR_HOME "$USER_HOME"
  require_value AGENTIC_REMOTE_MONITOR_HEALTH_URL "$HEALTH_URL"
  # Validate cross-field requirements before anything is built or restarted, so
  # an incomplete downstream profile cannot be discovered after local promotion.
  if [[ -n "$DOWNSTREAM_HOSTS" ]]; then
    require_value AGENTIC_REMOTE_MONITOR_DOWNSTREAM_ROOT "$DOWNSTREAM_ROOT"
    require_value AGENTIC_REMOTE_MONITOR_DOWNSTREAM_HEALTH_URL \
      "$DOWNSTREAM_HEALTH_URL"
  fi

  mkdir -p "$STATE_DIR"
  require_command flock
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    log "another promotion run is already active; skipping"
    return
  fi

  require_command corepack
  require_command curl
  require_command git
  require_command python3
  require_command systemctl
  [[ -z "$DOWNSTREAM_HOSTS" ]] || require_command ssh

  assert_repository "$DEV_ROOT"
  assert_repository "$PROD_ROOT"

  local release_root pending_branch
  release_root="$(resolve_path "$RELEASE_ROOT")"
  [[ "$release_root" == "$(resolve_path "$USER_HOME/.config/agentic-remote/releases")" ]] ||
    die "the release root must match the application CLI release directory"
  if [[ -e "$PENDING_RECORD" || -L "$PENDING_RECORD" ]]; then
    pending_branch="$(git -C "$PROD_ROOT" branch --show-current)"
    [[ -z "$pending_branch" ]] ||
      die "production runtime checkout must remain detached while recovering promotion"
    assert_clean "$PROD_ROOT"
    recover_pending_promotion
    return
  fi

  local dev_branch before_commit candidate_commit
  dev_branch="$(git -C "$DEV_ROOT" branch --show-current)"
  [[ "$dev_branch" == "main" ]] ||
    die "development checkout must be on main: $DEV_ROOT"
  assert_clean "$DEV_ROOT"

  before_commit="$(git -C "$DEV_ROOT" rev-parse HEAD)"
  log "pulling development main at $before_commit"
  git -C "$DEV_ROOT" fetch --prune origin
  git -C "$DEV_ROOT" pull --ff-only
  candidate_commit="$(git -C "$DEV_ROOT" rev-parse HEAD)"
  assert_clean "$DEV_ROOT"

  # A clean local main can still sit ahead of its upstream, and CI for such a
  # commit may come from a feature branch. Only graduate what origin/main has.
  local origin_main
  origin_main="$(git -C "$DEV_ROOT" rev-parse refs/remotes/origin/main)"
  [[ "$candidate_commit" == "$origin_main" ]] ||
    die "development main is not at origin/main ($candidate_commit != $origin_main)"

  local prod_branch prod_commit last_commit
  prod_branch="$(git -C "$PROD_ROOT" branch --show-current)"
  [[ -z "$prod_branch" ]] ||
    die "production runtime checkout must remain detached: $PROD_ROOT"
  assert_clean "$PROD_ROOT"
  prod_commit="$(git -C "$PROD_ROOT" rev-parse HEAD)"
  last_commit=""
  if [[ -f "$STATE_RECORD" ]]; then
    last_commit="$(sed -n 's/^promoted_commit=//p' "$STATE_RECORD" | tail -n 1)"
  fi
  if [[ -z "$last_commit" && -f "$STATE_FILE" ]]; then
    last_commit="$(cat "$STATE_FILE")"
  fi
  [[ -z "$last_commit" || "$prod_commit" == "$last_commit" ]] ||
    die "the unrecorded runtime source has no pending promotion; reconcile the known-good baseline before retrying"

  if [[ "$candidate_commit" == "$prod_commit" && "$candidate_commit" == "$last_commit" ]]; then
    log "no ungraduated commit; development and production are at $candidate_commit"
    return
  fi

  if [[ "$candidate_commit" == "$before_commit" ]]; then
    log "main did not advance; retrying the unrecorded production state"
  else
    log "main advanced to $candidate_commit"
  fi

  # Validation runs in a worktree of its own, pinned to the commit being
  # promoted, under the state directory.
  #
  # The development checkout is where someone works, and it can be on a
  # filesystem chosen for that rather than for speed: on a Windows drive seen
  # through WSL the same suite takes 531 seconds instead of 77, and the test
  # runner gives up waiting for its own workers to start. That ends the run
  # with `Timeout waiting for worker to respond` while every test passes,
  # which stops a release over where the checkout happens to live.
  #
  # Pinning also means what passed is what is promoted, rather than whatever
  # the development checkout became while the suite was running.
  # Script scope, not the run's. The EXIT trap fires after this function has
  # been unwound, so locals are gone by then and `set -u` turned every failed
  # validation into an unbound-variable abort that cleaned up nothing.
  VALIDATE_ROOT="$STATE_DIR/validate"
  VALIDATE_MARKER="$STATE_DIR/validate.owned"
  # The state directory comes from the profile, so this path is not trusted to
  # be somewhere disposable. It is checked before anything is created, while
  # refusing still costs nothing.
  assert_disposable "$VALIDATE_ROOT"

  trap cleanup_validation_worktree EXIT
  cleanup_validation_worktree
  log "preparing validation worktree at $VALIDATE_ROOT"
  # The token is this run's, and goes into both the marker and the worktree's
  # own lock reason. A worktree somebody else makes at this path after an
  # interrupted run carries no such reason, so a marker left behind cannot
  # vouch for it.
  local validate_token
  validate_token="$(date +%s)-$$-${RANDOM}"
  printf '%s\n%s\n' "$(resolve_path "$VALIDATE_ROOT")" "$validate_token" \
    >"$VALIDATE_MARKER"
  # `--lock --reason` writes the signature as part of registering the worktree,
  # so there is no moment where a worktree exists that nothing vouches for. A
  # run killed immediately after this line still leaves a worktree the next run
  # recognises as the monitor's and clears away, rather than one it refuses to
  # touch for ever.
  #
  # The lock earns its keep twice over: git will not prune a locked worktree,
  # so an unrelated `git worktree prune` in this repository cannot take the
  # record away while validation is using it.
  git -C "$DEV_ROOT" worktree add --detach \
    --lock --reason "$VALIDATE_LOCK_SIGNATURE $validate_token" \
    "$VALIDATE_ROOT" "$candidate_commit"

  log "installing validation dependencies"
  CI=true run_pnpm "$VALIDATE_ROOT" install --frozen-lockfile
  log "running validation lint"
  CI=true run_pnpm "$VALIDATE_ROOT" lint
  # The repository has no hosted CI, so the suite that used to gate promotion
  # remotely has to run here. Without it nothing would exercise the tests
  # before a commit reaches production.
  log "running validation tests"
  CI=true run_pnpm "$VALIDATE_ROOT" test
  log "building validation release"
  CI=true run_pnpm "$VALIDATE_ROOT" build
  assert_clean "$VALIDATE_ROOT"
  # Clean is not the same as unchanged. A validation command, or anything else
  # reaching into the worktree, can leave it detached at some other commit and
  # perfectly tidy -- and the whole point of validating here is that what was
  # tested is what gets promoted.
  local validated_head
  validated_head="$(git -C "$VALIDATE_ROOT" rev-parse HEAD)" ||
    die "validation worktree HEAD could not be read"
  [[ "$validated_head" == "$candidate_commit" ]] ||
    die "validation worktree moved to $validated_head, not $candidate_commit"
  cleanup_validation_worktree
  trap - EXIT
  assert_clean "$DEV_ROOT"

  assert_clean "$PROD_ROOT"
  prod_branch="$(git -C "$PROD_ROOT" branch --show-current)"
  [[ -z "$prod_branch" ]] ||
    die "production runtime checkout changed to a branch during validation"
  [[ "$(git -C "$PROD_ROOT" rev-parse HEAD)" == "$prod_commit" ]] ||
    die "production runtime source changed during validation"

  log "graduating $candidate_commit to the production runtime source"
  local previous_release="" existing_releases="" publication_id
  publication_id="$(date -u +%Y%m%dT%H%M%SZ)-${candidate_commit:0:12}-$$-${RANDOM}"
  local candidate_release="$release_root/$publication_id"
  [[ ! -e "$candidate_release" && ! -L "$candidate_release" ]] ||
    die "the candidate release path already exists"
  if [[ -d "$RELEASE_ROOT" ]]; then
    existing_releases="$(find "$RELEASE_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n')" ||
      die "could not read the release inventory before graduation"
  fi
  if [[ -L "$RELEASE_ROOT/current" ]]; then
    previous_release="$(readlink -f -- "$RELEASE_ROOT/current" || true)"
  fi
  [[ -z "$previous_release" || ! -e "$previous_release/.promotion-failed" ]] ||
    die "the current release was rejected; restore a healthy release before retrying promotion"
  [[ -z "$previous_release" ||
    ( "$(dirname -- "$previous_release")" == "$release_root" &&
      -d "$previous_release" && ! -L "$previous_release" ) ]] ||
    die "the previous release is not a direct immutable release in the configured inventory"
  ! grep -Fxq -- "$publication_id" <<<"$existing_releases" ||
    die "the candidate release appeared before promotion was recorded"
  write_pending_promotion prepared "$candidate_commit" "$prod_commit" \
    "$candidate_release" "$previous_release" ||
    die "could not durably record the pending promotion; no candidate was activated"
  load_pending_promotion
  [[ "$(read_current_release)" == "$previous_release" ]] ||
    die "the current release changed while preparing promotion; the pending journal was retained"
  # Publishing prunes by directory mtime. Keep the known-good rollback target
  # newer than older failed candidates so setup cannot delete it before health
  # validation decides whether the new release is safe.
  [[ -z "$previous_release" || ! -d "$previous_release" ]] ||
    touch -- "$previous_release"
  git -C "$PROD_ROOT" switch --detach "$candidate_commit"

  local setup_environment=()
  [[ -z "$DATA_DIR" ]] || setup_environment+=("AGENTIC_REMOTE_DATA_DIR=$DATA_DIR")
  [[ -z "$ALLOWED_ROOTS" ]] || setup_environment+=("AGENTIC_REMOTE_ALLOWED_ROOTS=$ALLOWED_ROOTS")
  [[ -z "$ALLOWED_ORIGINS" ]] || setup_environment+=("AGENTIC_REMOTE_ALLOWED_ORIGINS=$ALLOWED_ORIGINS")

  # Only pass runtime identity that the profile sets explicitly. Passing a
  # default would override the host's installed role, name, or bind address and
  # silently convert a paired node into a hub on the first graduation.
  local setup_arguments=()
  [[ -z "$PRODUCTION_HOST" ]] || setup_arguments+=(--host "$PRODUCTION_HOST")
  [[ -z "$PRODUCTION_PORT" ]] || setup_arguments+=(--port "$PRODUCTION_PORT")
  [[ -z "$PRODUCTION_ROLE" ]] || setup_arguments+=(--role "$PRODUCTION_ROLE")
  [[ -z "$PRODUCTION_NAME" ]] || setup_arguments+=(--name "$PRODUCTION_NAME")
  setup_arguments+=(--release-id "$publication_id")

  # Everything below has already replaced the running service, so each failure
  # must restore the previous commit and release instead of leaving the failed
  # candidate active for the next run to overwrite.
  local failure=""
  env \
    HOME="$USER_HOME" \
    PATH="$RUNTIME_TOOLS:$USER_HOME/.local/bin:$PATH" \
    CI=true \
    "${setup_environment[@]}" \
    "$PROD_ROOT/bin/agentic-remote" setup "${setup_arguments[@]}" ||
    failure="setup failed for $candidate_commit"

  if [[ -z "$failure" ]]; then
    failure="$(verify_local_promotion "$candidate_commit" "$candidate_release")" || {
      [[ -n "$failure" ]] || failure="production verification did not complete"
    }
  fi

  if [[ -n "$failure" ]]; then
    log "ERROR: $failure"
    recover_pending_promotion rejected
    die "graduation failed; recovery did not complete"
  fi

  write_pending_promotion local-verified "$candidate_commit" "$prod_commit" \
    "$candidate_release" "$previous_release" ||
    die "could not record local verification; the pending promotion was retained"
  # Downstream hosts are promoted before the success marker advances, so a
  # failure there leaves the candidate ungraduated and the next run retries.
  if ! promote_downstream "$candidate_commit"; then
    die "downstream promotion failed; the success marker was left unchanged"
  fi

  write_pending_promotion verified "$candidate_commit" "$prod_commit" \
    "$candidate_release" "$previous_release" ||
    die "could not record completed verification; the pending promotion was retained"
  load_pending_promotion
  complete_pending_promotion
}

command="${1:-run}"
case "$command" in
  run)
    (($# == 1)) || die "run does not accept options"
    run
    ;;
  *)
    die "usage: agentic-remote-promotion-monitor [run]"
    ;;
esac
