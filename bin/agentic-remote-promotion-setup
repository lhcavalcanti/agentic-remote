#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
# AGENTIC_REMOTE_PROMOTION_HOME relocates the profile, monitor, and unit files
# only. systemctl --user still acts on the caller's own systemd session, so
# `enable` from an overridden home arms the real timer. It is not a sandbox.
readonly USER_HOME="${AGENTIC_REMOTE_PROMOTION_HOME:-${HOME:-}}"
readonly CONFIG_DIR="$USER_HOME/.config/agentic-remote"
readonly SYSTEMD_DIR="$USER_HOME/.config/systemd/user"
readonly PROFILE_DEST="$CONFIG_DIR/promotion.env"
readonly INSTALL_DIR="$USER_HOME/.local/lib/agentic-remote"
readonly MONITOR_DEST="$INSTALL_DIR/promotion-monitor"
readonly SERVICE_NAME="agentic-remote-promotion-monitor.service"
readonly TIMER_NAME="agentic-remote-promotion-monitor.timer"
readonly SERVICE_FILE="$SYSTEMD_DIR/$SERVICE_NAME"
readonly TIMER_FILE="$SYSTEMD_DIR/$TIMER_NAME"
readonly EXAMPLE_PROFILE="$REPO_ROOT/config/agentic-remote-promotion.env.example"

usage() {
  cat <<'EOF'
Usage: agentic-remote-promotion-setup <command> [options]

Commands:
  init [--force]
      Copy the repository profile example to the local profile path.
  install [--profile FILE] [--create-runtime] [--enable]
      Install the local monitor and user systemd units. Disabled by default.
      --create-runtime creates the detached production worktree when absent.
      --enable arms the timer like enable, but does not resume a pause.
  refresh
      Refresh the installed monitor and units without changing the profile or
      the timer's enabled/running state. A paused monitor stays paused.
  enable
      Check the health URL, clear any pause, and enable and start the local
      two-hour promotion timer.
  disable [--reason TEXT]
      Durably pause promotion, then disable and stop the local timer. The
      pause survives refreshes, installs, and a timer started by anything
      else; only enable clears it.
  status
      Show whether promotion is paused, enabled, or disabled, and the timer
      status. Exits 0 when paused.
  uninstall
      Remove the local monitor and systemd units, preserving profile and state.
EOF
}

die() {
  printf 'agentic-remote-promotion-setup: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

systemd_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

profile_value() {
  local profile="$1" key="$2"
  sed -n "s/^${key}=//p" "$profile" | tail -n 1
}

validate_profile() {
  local profile="$1" key
  [[ -f "$profile" ]] || die "profile not found: $profile"
  if grep -Eq '/absolute/path|/home/USER|owner/repository|github-user' "$profile"; then
    die "replace the placeholders in the profile before installing it: $profile"
  fi
  for key in \
    AGENTIC_REMOTE_MONITOR_HOME \
    AGENTIC_REMOTE_MONITOR_DEV_ROOT \
    AGENTIC_REMOTE_MONITOR_PROD_ROOT \
    AGENTIC_REMOTE_MONITOR_RELEASE_ROOT \
    AGENTIC_REMOTE_MONITOR_SERVICE \
    AGENTIC_REMOTE_MONITOR_HEALTH_URL; do
    [[ -n "$(profile_value "$profile" "$key")" ]] ||
      die "profile is missing $key: $profile"
  done
}

# Resolved the way the monitor resolves it, so the pause recorded here is the
# one the monitor reads.
monitor_state_dir() {
  local state_dir="" monitor_home=""
  if [[ -f "$PROFILE_DEST" ]]; then
    state_dir="$(profile_value "$PROFILE_DEST" AGENTIC_REMOTE_MONITOR_STATE_DIR)"
    monitor_home="$(profile_value "$PROFILE_DEST" AGENTIC_REMOTE_MONITOR_HOME)"
  fi
  [[ -n "$state_dir" ]] ||
    state_dir="${monitor_home:-$USER_HOME}/.local/state/agentic-remote-monitor"
  printf '%s' "$state_dir"
}

# Reads, records, or clears the operator pause in the monitor's state
# directory. Exits 10 when no pause is recorded, and 2 after printing why when
# the pause state cannot be read or changed. The monitor carries the same
# reader.
pause_marker() {
  local action="$1" reason="${2:-}"
  python3 - "$action" "$(monitor_state_dir)/promotion-paused" "$reason" <<'PY'
import datetime
import os
import stat
import sys

action, marker, reason = sys.argv[1:]
state_dir = os.path.dirname(marker)


def sync_directory():
    fd = os.open(state_dir, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


try:
    if action == "read":
        try:
            info = os.lstat(marker)
        except FileNotFoundError:
            sys.exit(10)
        if not stat.S_ISREG(info.st_mode):
            raise OSError("the pause marker is not a regular file")
        fields = {}
        with open(marker, encoding="utf-8") as stream:
            for line in stream:
                key, separator, value = line.rstrip("\n").partition("=")
                if separator:
                    fields[key] = value
        print(fields.get("paused_at", ""))
        print(fields.get("reason", ""))
    elif action == "write":
        os.makedirs(state_dir, mode=0o700, exist_ok=True)
        paused_at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        temporary = os.path.join(state_dir, ".promotion-paused-%d" % os.getpid())
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write("paused_at=" + paused_at + "\n")
                if reason:
                    stream.write("reason=" + reason + "\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.rename(temporary, marker)
        except BaseException:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
            raise
        sync_directory()
        print(paused_at)
    elif action == "clear":
        try:
            os.unlink(marker)
        except FileNotFoundError:
            sys.exit(10)
        sync_directory()
    else:
        raise ValueError("unknown pause action: " + action)
except Exception as error:
    print(getattr(error, "strerror", None) or error)
    sys.exit(2)
PY
}

# Succeeds when promotion is paused, setting PAUSED_AT and PAUSE_REASON.
# Returns 1 when it is not, and 2 with PAUSE_ERROR set when the pause state
# cannot be read, which callers treat as paused rather than override.
read_pause_state() {
  local state status=0
  local -a fields
  PAUSED_AT="" PAUSE_REASON="" PAUSE_ERROR=""
  state="$(pause_marker read)" || status=$?
  case "$status" in
    0)
      mapfile -t fields <<<"$state"
      PAUSED_AT="${fields[0]:-an unknown time}"
      PAUSE_REASON="${fields[1]:-}"
      ;;
    10)
      return 1
      ;;
    *)
      PAUSE_ERROR="${state:-unknown error}"
      return 2
      ;;
  esac
}

pause_description() {
  if [[ -n "$PAUSE_ERROR" ]]; then
    printf 'paused (pause state could not be read: %s)' "$PAUSE_ERROR"
  else
    printf 'paused since %s%s' "$PAUSED_AT" "${PAUSE_REASON:+ ($PAUSE_REASON)}"
  fi
}

# Succeeds only once the timer is neither active nor enabled.
disarm_timer() {
  systemctl --user disable --now "$TIMER_NAME" 2>/dev/null || true
  ! systemctl --user is-active --quiet "$TIMER_NAME" 2>/dev/null &&
    ! systemctl --user is-enabled --quiet "$TIMER_NAME" 2>/dev/null
}

# Rewritten units must not carry forward a timer that something rearmed while
# promotion was paused.
hold_pause() {
  if [[ -n "$PAUSE_ERROR" ]]; then
    printf 'agentic-remote-promotion-setup: pause state could not be read (%s); treating promotion as paused\n' \
      "$PAUSE_ERROR" >&2
  fi
  disarm_timer ||
    printf 'agentic-remote-promotion-setup: the promotion timer is still active or enabled; paused runs exit without changes\n' >&2
}

write_units() {
  local dev_root node_bin corepack_bin runtime_path service_temporary timer_temporary
  node_bin="$(command -v node)"
  corepack_bin="$(command -v corepack)"
  runtime_path="$(dirname "$node_bin"):$(dirname "$corepack_bin"):/usr/local/bin:/usr/bin:/bin"
  dev_root="$(profile_value "$PROFILE_DEST" AGENTIC_REMOTE_MONITOR_DEV_ROOT)"
  [[ -n "$dev_root" ]] || die "profile is missing AGENTIC_REMOTE_MONITOR_DEV_ROOT"

  service_temporary="$(mktemp "$SYSTEMD_DIR/.agentic-remote-promotion-monitor.service.XXXXXX")"
  timer_temporary="$(mktemp "$SYSTEMD_DIR/.agentic-remote-promotion-monitor.timer.XXXXXX")"
  cat >"$service_temporary" <<EOF
[Unit]
Description=Validate and graduate Agentic Remote development builds
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$dev_root
Environment=$(systemd_quote "HOME=$USER_HOME")
Environment=$(systemd_quote "AGENTIC_REMOTE_MONITOR_PROFILE=$PROFILE_DEST")
Environment=$(systemd_quote "PATH=$runtime_path")
# A full validation run (install, lint, the whole suite, build) plus
# graduation measured 16.5 minutes, and the suite grows as tests are added.
# A timeout here is not a clean abort: the kill can land after setup has
# already replaced the running service, leaving recovery half done. Keep
# several times the observed cost in reserve.
TimeoutStartSec=60min
ExecStart=$(systemd_quote "$MONITOR_DEST") run
EOF

  cat >"$timer_temporary" <<EOF
[Unit]
Description=Check and graduate Agentic Remote builds every two hours

[Timer]
# A calendar schedule so the next run is always defined. Monotonic triggers do
# not survive a long-lived session: a boot-relative trigger elapses once and
# never returns, and a unit-active-relative one can leave the timer with no
# next elapse at all, so an enabled timer would silently never run. Catching up
# a missed run also requires a calendar schedule.
OnCalendar=*-*-* 0/2:00:00
Persistent=true
RandomizedDelaySec=5min
Unit=$SERVICE_NAME

[Install]
WantedBy=timers.target
EOF
  chmod 0600 "$service_temporary" "$timer_temporary"
  mv -f -- "$service_temporary" "$SERVICE_FILE"
  mv -f -- "$timer_temporary" "$TIMER_FILE"
}

install_monitor_binary() {
  local temporary
  temporary="$(mktemp "$INSTALL_DIR/.promotion-monitor.XXXXXX")"
  install -m 0755 "$REPO_ROOT/bin/agentic-remote-promotion-monitor" "$temporary"
  mv -f -- "$temporary" "$MONITOR_DEST"
}

create_runtime_worktree() {
  local dev_root prod_root prod_branch
  dev_root="$(profile_value "$PROFILE_DEST" AGENTIC_REMOTE_MONITOR_DEV_ROOT)"
  prod_root="$(profile_value "$PROFILE_DEST" AGENTIC_REMOTE_MONITOR_PROD_ROOT)"
  [[ -n "$dev_root" && -n "$prod_root" ]] ||
    die "profile must define development and production runtime roots"
  [[ "$dev_root" != "$prod_root" ]] ||
    die "development and production runtime roots must be different"
  git -C "$dev_root" rev-parse --show-toplevel >/dev/null 2>&1 ||
    die "development root is not a Git repository: $dev_root"
  [[ "$(git -C "$dev_root" branch --show-current)" == "main" ]] ||
    die "development root must be on main: $dev_root"
  [[ -z "$(git -C "$dev_root" status --porcelain)" ]] ||
    die "development root must be clean before creating the runtime worktree"

  if [[ -e "$prod_root" || -L "$prod_root" ]]; then
    git -C "$prod_root" rev-parse --show-toplevel >/dev/null 2>&1 ||
      die "production runtime path exists but is not a Git worktree: $prod_root"
    prod_branch="$(git -C "$prod_root" branch --show-current)"
    [[ -z "$prod_branch" ]] ||
      die "existing production runtime worktree must be detached: $prod_root"
    return
  fi

  mkdir -p "$(dirname "$prod_root")"
  git -C "$dev_root" worktree add --detach "$prod_root" HEAD
}

init_profile() {
  local force=0
  while (($# > 0)); do
    case "$1" in
      --force)
        force=1
        shift
        ;;
      *)
        die "unknown init option: $1"
        ;;
    esac
  done
  [[ -f "$EXAMPLE_PROFILE" ]] || die "profile example not found: $EXAMPLE_PROFILE"
  if [[ -e "$PROFILE_DEST" && "$force" != 1 ]]; then
    die "profile already exists; use init --force to replace it"
  fi
  mkdir -p "$CONFIG_DIR"
  local temporary
  temporary="$(mktemp "$CONFIG_DIR/.promotion.env.XXXXXX")"
  install -m 0600 "$EXAMPLE_PROFILE" "$temporary"
  mv -f -- "$temporary" "$PROFILE_DEST"
  printf 'Created %s; edit it before installing the monitor.\n' "$PROFILE_DEST"
}

install_monitor() {
  local profile="$PROFILE_DEST" enable=0 create_runtime=0
  while (($# > 0)); do
    case "$1" in
      --profile)
        (($# >= 2)) || die "--profile requires a value"
        profile="$2"
        shift 2
        ;;
      --enable)
        enable=1
        shift
        ;;
      --create-runtime)
        create_runtime=1
        shift
        ;;
      *)
        die "unknown install option: $1"
        ;;
    esac
  done

  require_command corepack
  require_command node
  require_command python3
  require_command systemctl
  validate_profile "$profile"
  mkdir -p "$CONFIG_DIR" "$INSTALL_DIR" "$SYSTEMD_DIR"

  local temporary
  temporary="$(mktemp "$CONFIG_DIR/.promotion.env.XXXXXX")"
  install -m 0600 "$profile" "$temporary"
  mv -f -- "$temporary" "$PROFILE_DEST"
  if [[ "$create_runtime" == 1 ]]; then
    create_runtime_worktree
  fi
  install_monitor_binary
  write_units
  systemctl --user daemon-reload
  local pause_status=0
  read_pause_state || pause_status=$?
  if [[ "$pause_status" != 1 ]]; then
    # Provisioning can be re-run by automation, so not even --enable resumes
    # an explicit pause. Only the enable command clears it.
    hold_pause
    printf 'Local promotion monitor installed; promotion stays %s; timer left disabled, run enable to resume.\n' \
      "$(pause_description)"
  elif [[ "$enable" == 1 ]]; then
    # Route through enable_monitor so --enable gets the same health preflight as
    # the standalone command instead of arming an unverified timer.
    enable_monitor
  else
    printf 'Local promotion monitor installed and disabled by default.\n'
  fi
}

refresh_monitor() {
  require_command corepack
  require_command node
  require_command python3
  require_command systemctl
  [[ -f "$PROFILE_DEST" ]] ||
    die "monitor profile is not installed; run install first"
  [[ -f "$SERVICE_FILE" && -f "$TIMER_FILE" && -f "$MONITOR_DEST" ]] ||
    die "monitor is not installed; run install first"
  validate_profile "$PROFILE_DEST"

  local was_enabled=0 was_active=0 pause_status=0
  systemctl --user is-enabled --quiet "$TIMER_NAME" 2>/dev/null &&
    was_enabled=1
  systemctl --user is-active --quiet "$TIMER_NAME" 2>/dev/null &&
    was_active=1
  read_pause_state || pause_status=$?

  install_monitor_binary
  write_units
  systemctl --user daemon-reload
  if [[ "$pause_status" != 1 ]]; then
    hold_pause
    printf 'Local promotion monitor refreshed; profile preserved, promotion stays %s; timer left disabled, run enable to resume.\n' \
      "$(pause_description)"
    return
  fi
  if [[ "$was_enabled" == 1 ]]; then
    systemctl --user enable "$TIMER_NAME"
  fi
  if [[ "$was_active" == 1 ]]; then
    systemctl --user restart "$TIMER_NAME"
  fi
  printf 'Local promotion monitor refreshed; profile preserved, timer enabled=%s active=%s.\n' \
    "$was_enabled" "$was_active"
}

enable_monitor() {
  require_command systemctl
  require_command curl
  require_command python3
  [[ -f "$SERVICE_FILE" && -f "$TIMER_FILE" ]] ||
    die "monitor is not installed; run install first"

  # The health check runs after the service has already been replaced, so an
  # unreachable URL turns every promotion into a restart that then reports
  # failure. Refuse to arm the timer until the URL actually answers.
  local health_url
  health_url="$(profile_value "$PROFILE_DEST" AGENTIC_REMOTE_MONITOR_HEALTH_URL)"
  [[ -n "$health_url" ]] ||
    die "set AGENTIC_REMOTE_MONITOR_HEALTH_URL in $PROFILE_DEST before enabling"
  curl -fsS --max-time 10 "$health_url" >/dev/null ||
    die "health URL did not answer: $health_url"

  # Only after the preflight, so a failed enable leaves the pause in force.
  local cleared clear_status=0
  cleared="$(pause_marker clear)" || clear_status=$?
  case "$clear_status" in
    0) printf 'Promotion pause cleared.\n' ;;
    10) ;;
    *) die "could not clear the promotion pause (${cleared:-unknown error}); the timer was not armed" ;;
  esac

  systemctl --user daemon-reload
  systemctl --user enable --now "$TIMER_NAME"
  # An already-running timer keeps the schedule it started with, so a changed
  # unit would not take effect until the next session. Restart it so the
  # installed schedule is the one that is armed.
  systemctl --user restart "$TIMER_NAME"
  printf 'Local promotion monitor enabled. Next run: %s\n' \
    "$(systemctl --user show "$TIMER_NAME" -p NextElapseUSecRealtime --value)"
}

disable_monitor() {
  local reason=""
  while (($# > 0)); do
    case "$1" in
      --reason)
        (($# >= 2)) || die "--reason requires a value"
        reason="$2"
        shift 2
        ;;
      *)
        die "unknown disable option: $1"
        ;;
    esac
  done
  [[ "$reason" != *[[:cntrl:]]* ]] ||
    die "the pause reason must be a single line of text"
  require_command systemctl
  require_command python3

  # Recorded before the timer is touched, so a run started in between, or by
  # anything that rearms the timer later, already sees the pause.
  local paused_at
  if ! paused_at="$(pause_marker write "$reason")"; then
    systemctl --user disable --now "$TIMER_NAME" 2>/dev/null || true
    die "could not record the promotion pause (${paused_at:-unknown error}); the timer was stopped, but nothing keeps it from being rearmed"
  fi
  disarm_timer ||
    die "the pause was recorded, but the promotion timer is still active or enabled; paused runs exit without changes"
  printf 'Local promotion monitor paused since %s%s; timer disabled.\n' \
    "$paused_at" "${reason:+ ($reason)}"
  if systemctl --user is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
    printf 'A promotion run is in progress. It stops before graduation, or completes a promotion it already started.\n'
  fi
}

status_monitor() {
  require_command systemctl
  require_command python3
  local enabled=0 active=0 pause_status=0 timer_status=0
  systemctl --user is-enabled --quiet "$TIMER_NAME" 2>/dev/null && enabled=1
  systemctl --user is-active --quiet "$TIMER_NAME" 2>/dev/null && active=1
  read_pause_state || pause_status=$?
  case "$pause_status" in
    0)
      printf 'Promotion: paused since %s\n' "$PAUSED_AT"
      [[ -z "$PAUSE_REASON" ]] || printf 'Pause reason: %s\n' "$PAUSE_REASON"
      ;;
    1)
      if [[ "$enabled" == 1 ]]; then
        printf 'Promotion: enabled\n'
      else
        printf 'Promotion: disabled\n'
      fi
      ;;
    *)
      printf 'Promotion: %s\n' "$(pause_description)"
      ;;
  esac
  printf 'Timer: enabled=%s active=%s\n' "$enabled" "$active"
  if [[ "$pause_status" != 1 && ("$enabled" == 1 || "$active" == 1) ]]; then
    printf 'Warning: the timer was rearmed while paused; its runs exit without changes.\n'
  fi
  systemctl --user --no-pager --full status "$TIMER_NAME" || timer_status=$?
  # An intentional pause is a healthy state for anything watching this, while
  # an unreadable one needs attention.
  case "$pause_status" in
    0) return 0 ;;
    1) return "$timer_status" ;;
    *) return 1 ;;
  esac
}

uninstall_monitor() {
  require_command systemctl
  systemctl --user disable --now "$TIMER_NAME" 2>/dev/null || true
  rm -f -- "$SERVICE_FILE" "$TIMER_FILE" "$MONITOR_DEST"
  systemctl --user daemon-reload
  printf 'Local promotion monitor removed; profile and state were preserved.\n'
}

command="${1:-}"
if (($# > 0)); then
  shift
fi

case "$command" in
  init)
    init_profile "$@"
    ;;
  install)
    install_monitor "$@"
    ;;
  refresh)
    (($# == 0)) || die "refresh does not accept options"
    refresh_monitor
    ;;
  enable)
    (($# == 0)) || die "enable does not accept options"
    enable_monitor
    ;;
  disable)
    disable_monitor "$@"
    ;;
  status)
    (($# == 0)) || die "status does not accept options"
    status_monitor
    ;;
  uninstall)
    (($# == 0)) || die "uninstall does not accept options"
    uninstall_monitor
    ;;
  *)
    usage
    [[ -z "$command" ]] || exit 1
    ;;
esac
