# Machine-local promotion profile.
# Copy this file outside the repository, replace every placeholder, and keep
# the resulting file private. Do not put credentials or pairing tokens here.
AGENTIC_REMOTE_MONITOR_HOME=/home/USER
AGENTIC_REMOTE_MONITOR_DEV_ROOT=/absolute/path/to/development/checkout
AGENTIC_REMOTE_MONITOR_PROD_ROOT=/absolute/path/to/production/runtime/worktree
AGENTIC_REMOTE_MONITOR_RELEASE_ROOT=/absolute/path/to/agentic-remote/releases
AGENTIC_REMOTE_MONITOR_STATE_DIR=/home/USER/.local/state/agentic-remote-monitor
AGENTIC_REMOTE_MONITOR_SERVICE=agentic-remote.service
# Readiness check performed after the service restarts. Required.
# /health reports readiness for both roles. /api/health exists only on a hub,
# so a node must not use it.
# The URL must match the address the service actually binds: a host configured
# with a LAN HOST does not answer on 127.0.0.1. `enable` probes this URL and
# refuses to start the timer until it answers.
AGENTIC_REMOTE_MONITOR_HEALTH_URL=
AGENTIC_REMOTE_MONITOR_EXTERNAL_URL=
AGENTIC_REMOTE_MONITOR_EXTERNAL_STATUS=
# Runtime identity is inherited from the installed service when left empty.
# Set these only to change the runtime deliberately: a value here overrides the
# installed role, name, or bind address on the next graduation.
AGENTIC_REMOTE_MONITOR_HOST=
AGENTIC_REMOTE_MONITOR_PORT=
AGENTIC_REMOTE_MONITOR_ROLE=
AGENTIC_REMOTE_MONITOR_NAME=
AGENTIC_REMOTE_MONITOR_GH_CONFIG_DIR=/absolute/path/to/gh/config
AGENTIC_REMOTE_MONITOR_GITHUB_USER=github-user
AGENTIC_REMOTE_MONITOR_REPOSITORY=owner/repository
AGENTIC_REMOTE_MONITOR_WORKFLOW=ci.yml
AGENTIC_REMOTE_RUNTIME_TOOLS=/home/USER/.local/share/agentic-remote-runtime-tools
AGENTIC_REMOTE_DATA_DIR=
AGENTIC_REMOTE_ALLOWED_ROOTS=
AGENTIC_REMOTE_ALLOWED_ORIGINS=
