[Unit]
Description=Agentic Remote
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/agentic-remote
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/agentic-remote/environment
ExecStart=%h/.local/bin/pnpm start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
