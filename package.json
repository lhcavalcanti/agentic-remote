{
  "name": "agentic-remote",
  "private": true,
  "version": "1.45.2",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "icons:pwa": "node --import tsx scripts/generate-pwa-icons.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:canary": "vitest run --project canary",
    "test:fast": "vitest run --project fast",
    "test:quick": "vitest run --mode quick --project fast",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "@github/copilot-sdk": "^1.0.28",
    "@ricky0123/vad-web": "0.0.31",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.64.0",
    "mermaid": "^12.2.0",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sherpa-onnx-node": "1.13.8",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
